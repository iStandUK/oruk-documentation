<subjectScheme id="eligibility" xml:lang="en-GB">
  <title>ORUK eligibility (draft from the pilot)</title>
  <subjectdef keys="elig-g00" href="../eligibility/elig-g00.dita">
    <topicmeta><navtitle>Must live in the area</navtitle><shortdesc>Living in, or having a local connection to, a named town, county, city, unitary authority area or country in order to use the service.</shortdesc></topicmeta>
    <subjectdef keys="elig-003" href="../eligibility/elig-003.dita">
      <topicmeta><navtitle>Must live in a unitary authority area</navtitle><shortdesc>Residence or a local connection (living, working, owning a business, attending education, or being registered with a GP) in one named unitary authority area or a neighbouring pair of areas.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="elig-004" href="../eligibility/elig-004.dita">
      <topicmeta><navtitle>Must live in a county or postcode area</navtitle><shortdesc>Living in a named county or its surrounding area, or in a listed set of postcode districts.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="elig-005" href="../eligibility/elig-005.dita">
      <topicmeta><navtitle>Must live in the country</navtitle><shortdesc>Living in, or being based in, a whole country such as England, Wales or the UK, or a city-wide service limited to one large city.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="elig-013" href="../eligibility/elig-013.dita">
      <topicmeta><navtitle>Must live in a three-town conurbation</navtitle><shortdesc>Living in a named group of three neighbouring towns that form one urban area, sometimes with a related need such as housing trouble.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="elig-014" href="../eligibility/elig-014.dita">
      <topicmeta><navtitle>Must live in a county and neighbouring areas</navtitle><shortdesc>Living in a named county, sometimes with a neighbouring borough, nearby counties or specified towns around it.</shortdesc></topicmeta>
    </subjectdef>
  </subjectdef>
  <subjectdef keys="elig-g01" href="../eligibility/elig-g01.dita">
    <topicmeta><navtitle>Carer status</navtitle><shortdesc>Conditions about being a carer or receiving care, including registering as a carer or staying with the person being cared for.</shortdesc></topicmeta>
    <subjectdef keys="elig-025" href="../eligibility/elig-025.dita">
      <topicmeta><navtitle>Giving or receiving care</navtitle><shortdesc>Being an unpaid carer for someone who needs help, or receiving paid or unpaid care yourself.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="elig-026" href="../eligibility/elig-026.dita">
      <topicmeta><navtitle>Carer must attend or register</navtitle><shortdesc>Conditions about a carer, such as having to be a carer, being registered with a carers' service, or a carer or parent having to stay with the person at sessions.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="elig-036" href="../eligibility/elig-036.dita">
      <topicmeta><navtitle>Home and living situation</navtitle><shortdesc>Conditions about where and how a person lives or whether they can get out, such as living alone, being housebound, owning or renting, or not being homeless.</shortdesc></topicmeta>
    </subjectdef>
  </subjectdef>
  <subjectdef keys="elig-g02" href="../eligibility/elig-g02.dita">
    <topicmeta><navtitle>Age requirements</navtitle><shortdesc>Conditions based on a person's age, such as being a young child, over 16, an adult, or in later life.</shortdesc></topicmeta>
    <subjectdef keys="elig-001" href="../eligibility/elig-001.dita">
      <topicmeta><navtitle>Older people only (over 50 to over 75)</navtitle><shortdesc>A minimum age in later life, such as over 50, 55, 65 or 75.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="elig-011" href="../eligibility/elig-011.dita">
      <topicmeta><navtitle>Minimum age 16</navtitle><shortdesc>A minimum age of 16, including 16-19 provision.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="elig-015" href="../eligibility/elig-015.dita">
      <topicmeta><navtitle>Young children and nursery age</navtitle><shortdesc>Children of pre-school or nursery age, or other early years or primary age conditions such as 2 to 4 or up to 5.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="elig-017" href="../eligibility/elig-017.dita">
      <topicmeta><navtitle>Consent or permission needed</navtitle><shortdesc>Needing consent or permission from a parent, guardian, family or other person before using or taking part in a service.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="elig-021" href="../eligibility/elig-021.dita">
      <topicmeta><navtitle>Adults only</navtitle><shortdesc>Services for adults, usually 18 or over, or at an advanced level.</shortdesc></topicmeta>
    </subjectdef>
  </subjectdef>
  <subjectdef keys="elig-g04" href="../eligibility/elig-g04.dita">
    <topicmeta><navtitle>Booking and limited places</navtitle><shortdesc>Conditions about how places are given out, such as limited capacity on a first come first served basis or by appointment only.</shortdesc></topicmeta>
    <subjectdef keys="elig-008" href="../eligibility/elig-008.dita">
      <topicmeta><navtitle>Limited places, first come first served</navtitle><shortdesc>Capacity limits on a session or class, with places given out on a first come, first served basis.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="elig-027" href="../eligibility/elig-027.dita">
      <topicmeta><navtitle>By appointment only</navtitle><shortdesc>Services available only by making an appointment, including appointment-based applications and clinics.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="elig-045" href="../eligibility/elig-045.dita">
      <topicmeta><navtitle>Booking required</navtitle><shortdesc>Needing to book a place or session before attending.</shortdesc></topicmeta>
    </subjectdef>
  </subjectdef>
  <subjectdef keys="elig-g05" href="../eligibility/elig-g05.dita">
    <topicmeta><navtitle>Referral required</navtitle><shortdesc>Needing to be referred to the service by a professional, whether any agency or a health or care professional.</shortdesc></topicmeta>
    <subjectdef keys="elig-034" href="../eligibility/elig-034.dita">
      <topicmeta><navtitle>Referral from any professional</navtitle><shortdesc>Referral through any professional or agency, or a choice between self-referral and professional referral.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="elig-049" href="../eligibility/elig-049.dita">
      <topicmeta><navtitle>Referral from a health professional</navtitle><shortdesc>Needing referral by a health or care professional, such as a healthcare worker, clinician or social prescriber.</shortdesc></topicmeta>
    </subjectdef>
  </subjectdef>
  <subjectdef keys="elig-g10" href="../eligibility/elig-g10.dita">
    <topicmeta><navtitle>Membership, fees and contact</navtitle><shortdesc>Practical conditions for joining in, such as paying a fee, becoming a member, or contacting the service before attending.</shortdesc></topicmeta>
    <subjectdef keys="elig-010" href="../eligibility/elig-010.dita">
      <topicmeta><navtitle>Fee or membership payment required</navtitle><shortdesc>A joining, membership, subscription or other fee that has to be paid to take part.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="elig-020" href="../eligibility/elig-020.dita">
      <topicmeta><navtitle>Contact before attending</navtitle><shortdesc>Needing to get in touch with the service first to enquire, check eligibility, discuss needs, or arrange a visit.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="elig-024" href="../eligibility/elig-024.dita">
      <topicmeta><navtitle>Membership required</navtitle><shortdesc>Needing to be, or become, a member of the group or club to take part.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="elig-051" href="../eligibility/elig-051.dita">
      <topicmeta><navtitle>Must have a disability or health condition</navtitle><shortdesc>Having a disability, impairment, medical condition or specific diagnosis to qualify.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="elig-053" href="../eligibility/elig-053.dita">
      <topicmeta><navtitle>Experience or skill level required</navtitle><shortdesc>Expecting a certain level of previous experience or qualification, or restricting to beginners.</shortdesc></topicmeta>
    </subjectdef>
  </subjectdef>
  <subjectdef keys="elig-g-other" href="../eligibility/elig-g-other.dita">
    <topicmeta><navtitle>Categories not yet in a group</navtitle><shortdesc>Categories that sit alone in the clustering hierarchy.</shortdesc></topicmeta>
    <subjectdef keys="elig-000" href="../eligibility/elig-000.dita">
      <topicmeta><navtitle>Single-sex sessions</navtitle><shortdesc>Sessions restricted to one gender, such as women-only, ladies-only, girls-only or boys-only, including related conditions about partners or recognised gender.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="elig-002" href="../eligibility/elig-002.dita">
      <topicmeta><navtitle>Registered with a local GP or NHS link</navtitle><shortdesc>Being registered with a GP in a stated area, or having an NHS connection such as being NHS staff or treated at a named hospital.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="elig-009" href="../eligibility/elig-009.dita">
      <topicmeta><navtitle>Fully paid-up members only</navtitle><shortdesc>Restricted to fully paid-up members of a specific membership organisation.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="elig-016" href="../eligibility/elig-016.dita">
      <topicmeta><navtitle>Must attend a particular school</navtitle><shortdesc>Pupils who attend, or whose school is in partnership with, a named school or group of schools.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="elig-022" href="../eligibility/elig-022.dita">
      <topicmeta><navtitle>Must live on a named street or estate</navtitle><shortdesc>Living in a very local area defined by a specific street, estate or housing area within a town.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="elig-044" href="../eligibility/elig-044.dita">
      <topicmeta><navtitle>Low income or on benefits</navtitle><shortdesc>Being on a low income, in financial hardship, or in receipt of means-tested benefits.</shortdesc></topicmeta>
    </subjectdef>
  </subjectdef>
</subjectScheme>
