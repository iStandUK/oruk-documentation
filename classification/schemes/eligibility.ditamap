<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE subjectScheme PUBLIC "-//OASIS//DTD DITA Subject Scheme Map//EN" "subjectScheme.dtd">
<!-- Generated by oruk-enrich/extract/export_dita.py from pilot-5, 2026-11-24. Do not edit by hand: regenerate. It is a DRAFT: names are model-made and no person has reviewed them. -->

<subjectScheme id="eligibility" xml:lang="en-GB">
  <title>ORUK eligibility (draft from the pilot)</title>
  <subjectdef keys="elig-g00" href="../eligibility/elig-g00.dita">
    <topicmeta><navtitle>Lives in a certain area</navtitle><shortdesc>Services restricted to people who live in, or are registered or resident in, a named county, council area, parish or country.</shortdesc></topicmeta>
    <subjectdef keys="elig-000" href="../eligibility/elig-000.dita">
      <topicmeta><navtitle>Registered with a local GP or NHS</navtitle><shortdesc>Services open only to people registered with a GP surgery in a named area, or otherwise tied to the NHS as staff or hospital patients.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="elig-002" href="../eligibility/elig-002.dita">
      <topicmeta><navtitle>Lives in Dorset</navtitle><shortdesc>Services restricted to people who live in Dorset or in a part of it, sometimes with neighbouring counties or postcode areas.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="elig-012" href="../eligibility/elig-012.dita">
      <topicmeta><navtitle>Lives in Shropshire and nearby areas</navtitle><shortdesc>Services restricted to people living in Shropshire, Telford and Wrekin or other named nearby places and regions, including some military-base dependants.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="elig-014" href="../eligibility/elig-014.dita">
      <topicmeta><navtitle>Lives in the UK or England</navtitle><shortdesc>Services open to people living anywhere in a whole country such as the UK, England or England and Wales, rather than a local area.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="elig-015" href="../eligibility/elig-015.dita">
      <topicmeta><navtitle>Lives in North Lincolnshire</navtitle><shortdesc>Services restricted to people who live or run a business in North Lincolnshire, sometimes together with North East Lincolnshire.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="elig-031" href="../eligibility/elig-031.dita">
      <topicmeta><navtitle>Local residents of a village or parish</navtitle><shortdesc>Services for people who simply count as residents, or who live in a named parish, village, estate or type of housing.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="elig-048" href="../eligibility/elig-048.dita">
      <topicmeta><navtitle>Lives in Bournemouth, Christchurch or Poole</navtitle><shortdesc>Services restricted to people living in the Bournemouth, Christchurch and Poole council area, including families and visitors to Bournemouth.</shortdesc></topicmeta>
    </subjectdef>
  </subjectdef>
  <subjectdef keys="elig-g01" href="../eligibility/elig-g01.dita">
    <topicmeta><navtitle>Age or school stage</navtitle><shortdesc>Services for people defined by a minimum age, a young age or stage, or attendance at a particular school.</shortdesc></topicmeta>
    <subjectdef keys="elig-004" href="../eligibility/elig-004.dita">
      <topicmeta><navtitle>Aged 50, 55 or 65 and over</navtitle><shortdesc>Services for older people, set by a minimum age of around 50 to 65.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="elig-011" href="../eligibility/elig-011.dita">
      <topicmeta><navtitle>Aged 16 or over</navtitle><shortdesc>Services open to people at or above a minimum age of 16.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="elig-013" href="../eligibility/elig-013.dita">
      <topicmeta><navtitle>Aged 18 or over</navtitle><shortdesc>Services open to adults, set by a minimum age of 18 (or 17), including phrases like adults only.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="elig-023" href="../eligibility/elig-023.dita">
      <topicmeta><navtitle>Young children by age or school stage</navtitle><shortdesc>Services for young children defined by their age or by their nursery or school stage, such as babies, toddlers, pre-schoolers and primary pupils.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="elig-024" href="../eligibility/elig-024.dita">
      <topicmeta><navtitle>Pupils of a particular school</navtitle><shortdesc>Services limited to children or students who attend a named school or type of school.</shortdesc></topicmeta>
    </subjectdef>
  </subjectdef>
  <subjectdef keys="elig-g03" href="../eligibility/elig-g03.dita">
    <topicmeta><navtitle>Booking, membership or contact first</navtitle><shortdesc>Services that must be accessed by joining as a member, booking, making an appointment or getting in touch before attending.</shortdesc></topicmeta>
    <subjectdef keys="elig-009" href="../eligibility/elig-009.dita">
      <topicmeta><navtitle>Single-gender or linked to members</navtitle><shortdesc>Services open only to one gender, such as women-only or men-only, or to people linked to existing members or a centre's other services.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="elig-028" href="../eligibility/elig-028.dita">
      <topicmeta><navtitle>Term-time and time-limited access</navtitle><shortdesc>Conditions that limit when or for how long a person can use a service, such as term-time-only sessions, fixed stay lengths, or having to attend at set intervals.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="elig-034" href="../eligibility/elig-034.dita">
      <topicmeta><navtitle>No referral or diagnosis needed</navtitle><shortdesc>Phrases saying what a person does not need in order to join, such as a referral, diagnosis or membership, along with related notes on prior experience or beginner level.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="elig-035" href="../eligibility/elig-035.dita">
      <topicmeta><navtitle>By appointment only</navtitle><shortdesc>Services or sessions that can only be used by making an appointment, or where an appointment is the way in.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="elig-038" href="../eligibility/elig-038.dita">
      <topicmeta><navtitle>Membership required</navtitle><shortdesc>Services open only to members, or where joining a club, group or library is needed in order to use them.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="elig-040" href="../eligibility/elig-040.dita">
      <topicmeta><navtitle>Contact first before attending</navtitle><shortdesc>People must get in touch with the service, by phone, email or form, before they come, for example to check eligibility, discuss needs or confirm a date.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="elig-041" href="../eligibility/elig-041.dita">
      <topicmeta><navtitle>Booking required</navtitle><shortdesc>A place or session must be booked before attending, by phone, email or an online system.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="elig-044" href="../eligibility/elig-044.dita">
      <topicmeta><navtitle>Pre-booking in advance</navtitle><shortdesc>Phrases that say the service, appointment or journey must be booked ahead of time, sometimes with a minimum notice period.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="elig-049" href="../eligibility/elig-049.dita">
      <topicmeta><navtitle>Living alone, housebound or unable to access services</navtitle><shortdesc>Conditions about a person's home life or ability to get out, such as living alone, being housebound, being unable to travel or use universal services.</shortdesc></topicmeta>
    </subjectdef>
  </subjectdef>
  <subjectdef keys="elig-g08" href="../eligibility/elig-g08.dita">
    <topicmeta><navtitle>Referral required</navtitle><shortdesc>Services that can only be used after a referral from the council, a health professional, another professional or an organisation.</shortdesc></topicmeta>
    <subjectdef keys="elig-001" href="../eligibility/elig-001.dita">
      <topicmeta><navtitle>Referral through the local council</navtitle><shortdesc>Access arranged through referral from, or funding by, the local council or local authority, sometimes together with the NHS.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="elig-017" href="../eligibility/elig-017.dita">
      <topicmeta><navtitle>Referral from a health professional</navtitle><shortdesc>Services that need a referral from a GP, doctor, nurse or other healthcare professional.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="elig-018" href="../eligibility/elig-018.dita">
      <topicmeta><navtitle>Referral by a professional</navtitle><shortdesc>Referral by a professional of any kind, such as a social worker or staff member, sometimes with self-referral also accepted.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="elig-029" href="../eligibility/elig-029.dita">
      <topicmeta><navtitle>Referral required</navtitle><shortdesc>General statements that a referral is needed, or that referrals come from agencies, charities or other organisations, without naming a single kind of referrer.</shortdesc></topicmeta>
    </subjectdef>
  </subjectdef>
  <subjectdef keys="elig-g-other" href="../eligibility/elig-g-other.dita">
    <topicmeta><navtitle>Categories not yet in a group</navtitle><shortdesc>Categories that sit alone in the clustering hierarchy.</shortdesc></topicmeta>
    <subjectdef keys="elig-005" href="../eligibility/elig-005.dita">
      <topicmeta><navtitle>Low income or on benefits</navtitle><shortdesc>Services open to people on a low income, in receipt of benefits, or in financial hardship.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="elig-006" href="../eligibility/elig-006.dita">
      <topicmeta><navtitle>Covers a named street or estate</navtitle><shortdesc>The service covers a small local area defined by a named road, lane, close, way or housing estate within a Shropshire town or village.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="elig-045" href="../eligibility/elig-045.dita">
      <topicmeta><navtitle>Experience of abuse, trauma or crisis</navtitle><shortdesc>Conditions about a person's difficult life experiences or risks, such as abuse, bereavement, stalking or crisis, including who is not suitable because of them.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="elig-046" href="../eligibility/elig-046.dita">
      <topicmeta><navtitle>Unpaid carers</navtitle><shortdesc>Services for people who care for a relative or friend who is ill, disabled or has additional needs, or who are significantly affected by their caring role.</shortdesc></topicmeta>
    </subjectdef>
  </subjectdef>
</subjectScheme>
