<!DOCTYPE subjectScheme PUBLIC "-//OASIS//DTD DITA Subject Scheme Map//EN" "subjectScheme.dtd">
<!-- Generated by oruk-enrich/extract/export_dita.py from pilot-5, 2026-11-25. Do not edit by hand: regenerate. It is a DRAFT: names are model-made and no person has reviewed them. -->

<subjectScheme id="audience" xml:lang="en-GB">
  <title>ORUK audience (draft from the pilot)</title>
  <subjectdef keys="aud-g00" href="../audience/aud-g00.dita">
    <topicmeta><navtitle>People needing support at home</navtitle><shortdesc>Lonely or isolated people, those with housing needs and those wanting to live independently at home.</shortdesc></topicmeta>
    <subjectdef keys="aud-066" href="../audience/aud-066.dita">
      <topicmeta><navtitle>Lonely or isolated people</navtitle><shortdesc>People who feel lonely or socially isolated and could benefit from company, connection or support to reduce isolation.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-084" href="../audience/aud-084.dita">
      <topicmeta><navtitle>People with housing needs</navtitle><shortdesc>People looking for, struggling to keep, or at risk of losing a home, along with housing-related phrases such as landlords and residential properties.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-102" href="../audience/aud-102.dita">
      <topicmeta><navtitle>People living independently at home</navtitle><shortdesc>Adults, often older or with support needs, who want or need help to stay safely and independently in their own home.</shortdesc></topicmeta>
    </subjectdef>
  </subjectdef>
  <subjectdef keys="aud-g01" href="../audience/aud-g01.dita">
    <topicmeta><navtitle>Local residents and community</navtitle><shortdesc>People defined by where they live or by belonging to the wider community, including volunteers and the organisations they work with.</shortdesc></topicmeta>
    <subjectdef keys="aud-068" href="../audience/aud-068.dita">
      <topicmeta><navtitle>Volunteers and voluntary organisations</navtitle><shortdesc>People who volunteer or want to volunteer, and the charities, community groups and other not-for-profit organisations that work with them.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-086" href="../audience/aud-086.dita">
      <topicmeta><navtitle>People living in Dorset</navtitle><shortdesc>People who live in Dorset or its districts and postcodes, with a few similar phrases naming other local areas.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-090" href="../audience/aud-090.dita">
      <topicmeta><navtitle>People living in Lancashire</navtitle><shortdesc>People who live anywhere in Lancashire or one of its towns and rural areas, plus a few similar phrases naming North Lincolnshire.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-145" href="../audience/aud-145.dita">
      <topicmeta><navtitle>Everyone in the community</navtitle><shortdesc>The whole community or any member of it, without restriction to a particular group of people.</shortdesc></topicmeta>
    </subjectdef>
  </subjectdef>
  <subjectdef keys="aud-g02" href="../audience/aud-g02.dita">
    <topicmeta><navtitle>People with mental health or substance problems</navtitle><shortdesc>People affected by mental ill health, low mood or drug and alcohol use, and those close to them.</shortdesc></topicmeta>
    <subjectdef keys="aud-050" href="../audience/aud-050.dita">
      <topicmeta><navtitle>People affected by drugs or alcohol</navtitle><shortdesc>People with a drug or alcohol problem, and family members or others affected by someone else's substance use.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-079" href="../audience/aud-079.dita">
      <topicmeta><navtitle>People with anxiety, stress or low mood</navtitle><shortdesc>People experiencing anxiety, stress, depression or low mood, often with feelings of overwhelm or a need for a safe, quiet space.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-085" href="../audience/aud-085.dita">
      <topicmeta><navtitle>Women with mental health needs</navtitle><shortdesc>Women and girls with mental health problems, including crisis, self-harm and mental health difficulties linked to motherhood.</shortdesc></topicmeta>
    </subjectdef>
  </subjectdef>
  <subjectdef keys="aud-g03" href="../audience/aud-g03.dita">
    <topicmeta><navtitle>Open to everyone</navtitle><shortdesc>Services open to people of any age or ability, or to general groups such as men, club members and those wanting to meet people.</shortdesc></topicmeta>
    <subjectdef keys="aud-025" href="../audience/aud-025.dita">
      <topicmeta><navtitle>People wanting to meet new people</navtitle><shortdesc>People who want to make friends, widen their social circle or get out of the house for company and social activity.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-055" href="../audience/aud-055.dita">
      <topicmeta><navtitle>All ages and abilities</navtitle><shortdesc>Open to people of any age and any level of ability or condition, with no restriction on who can take part.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-056" href="../audience/aud-056.dita">
      <topicmeta><navtitle>Men</navtitle><shortdesc>Services aimed at men or male-only groups, whatever their age or background.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-057" href="../audience/aud-057.dita">
      <topicmeta><navtitle>People of all ages</navtitle><shortdesc>Open to anyone of any age, from children to older people, with no age restriction.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-060" href="../audience/aud-060.dita">
      <topicmeta><navtitle>People of all abilities</navtitle><shortdesc>Services open to people of any ability or skill level, with no ability requirement for taking part.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-158" href="../audience/aud-158.dita">
      <topicmeta><navtitle>Club or group members</navtitle><shortdesc>Services for the members of a club, society or group, including those that say whether non-members may also take part.</shortdesc></topicmeta>
    </subjectdef>
  </subjectdef>
  <subjectdef keys="aud-g04" href="../audience/aud-g04.dita">
    <topicmeta><navtitle>People facing serious illness or bereavement</navtitle><shortdesc>People affected by cancer, terminal illness or the death of someone close, and their families.</shortdesc></topicmeta>
    <subjectdef keys="aud-021" href="../audience/aud-021.dita">
      <topicmeta><navtitle>People who are bereaved</navtitle><shortdesc>People grieving after the death of someone close, including those bereaved by suicide or sudden death and those who need practical help after a death.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-023" href="../audience/aud-023.dita">
      <topicmeta><navtitle>People with serious or terminal illness</navtitle><shortdesc>People with a life-limiting or advanced illness, or needing palliative and end-of-life care, and their families.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-024" href="../audience/aud-024.dita">
      <topicmeta><navtitle>People affected by cancer</navtitle><shortdesc>People who have or have had cancer, and the family, friends and carers who support them or have lost someone to it.</shortdesc></topicmeta>
    </subjectdef>
  </subjectdef>
  <subjectdef keys="aud-g05" href="../audience/aud-g05.dita">
    <topicmeta><navtitle>People with health conditions or injuries</navtitle><shortdesc>People living with, or recovering from, long-term, neurological, stroke, brain injury or other health problems.</shortdesc></topicmeta>
    <subjectdef keys="aud-008" href="../audience/aud-008.dita">
      <topicmeta><navtitle>People after stroke or brain injury</navtitle><shortdesc>People who have had a stroke, TIA or brain injury, with some nearby phrases about communication difficulties.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-009" href="../audience/aud-009.dita">
      <topicmeta><navtitle>People recovering from injury or illness</navtitle><shortdesc>People getting back to health after an injury, surgery, illness or hospital stay, including rehabilitation after discharge.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-014" href="../audience/aud-014.dita">
      <topicmeta><navtitle>People with long-term health conditions</navtitle><shortdesc>People living with ongoing or unspecified health conditions, including those with complex health needs.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-015" href="../audience/aud-015.dita">
      <topicmeta><navtitle>People with neurological conditions</navtitle><shortdesc>People living with a named or general neurological condition such as Parkinson's, motor neurone disease, Huntington's or functional neurological disorder.</shortdesc></topicmeta>
    </subjectdef>
  </subjectdef>
  <subjectdef keys="aud-g06" href="../audience/aud-g06.dita">
    <topicmeta><navtitle>People in hardship or crisis</navtitle><shortdesc>Vulnerable people facing homelessness, poverty, displacement or urgent distress.</shortdesc></topicmeta>
    <subjectdef keys="aud-029" href="../audience/aud-029.dita">
      <topicmeta><navtitle>Vulnerable people</navtitle><shortdesc>People described generally as vulnerable or at risk, including those needing help to stay safe at home, with no single condition named.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-046" href="../audience/aud-046.dita">
      <topicmeta><navtitle>People who are homeless</navtitle><shortdesc>People who are homeless, sleeping rough or at risk of losing their home.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-047" href="../audience/aud-047.dita">
      <topicmeta><navtitle>Refugees and asylum seekers</navtitle><shortdesc>People who have fled their country and are seeking or have been granted protection, including unaccompanied asylum-seeking children.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-094" href="../audience/aud-094.dita">
      <topicmeta><navtitle>People on low income or in financial hardship</navtitle><shortdesc>Individuals and families struggling with money, on a low income or means-tested benefits, or otherwise in need of material help.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-095" href="../audience/aud-095.dita">
      <topicmeta><navtitle>People in crisis or distress</navtitle><shortdesc>People in urgent need, crisis or extreme distress who need immediate help, including children at serious risk of harm.</shortdesc></topicmeta>
    </subjectdef>
  </subjectdef>
  <subjectdef keys="aud-g07" href="../audience/aud-g07.dita">
    <topicmeta><navtitle>Children and young people</navtitle><shortdesc>Children, teenagers and young people defined by age band, including pupils, juniors and under-age groups, along with adults defined by a minimum age.</shortdesc></topicmeta>
    <subjectdef keys="aud-032" href="../audience/aud-032.dita">
      <topicmeta><navtitle>Adults aged 18 and over</navtitle><shortdesc>Services for adults, described with the word "adults" and a minimum age of around 16 to 18.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-035" href="../audience/aud-035.dita">
      <topicmeta><navtitle>Anyone aged 18 or over</navtitle><shortdesc>Services open to anyone or any people above a minimum age, mostly 18 and over, worded as "aged", "anyone" or "people over".</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-062" href="../audience/aud-062.dita">
      <topicmeta><navtitle>Children and young people</navtitle><shortdesc>Services for children and young people as one broad group, usually with an age range from birth or primary age up to the late teens or 25, plus some professionals who work with them.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-088" href="../audience/aud-088.dita">
      <topicmeta><navtitle>Schools and pupils</navtitle><shortdesc>Services aimed at schools, colleges and their pupils, whether primary, secondary or whole-school.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-100" href="../audience/aud-100.dita">
      <topicmeta><navtitle>Teenagers</navtitle><shortdesc>Services for teenagers or teens, including some with a stated age range or a specific condition.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-120" href="../audience/aud-120.dita">
      <topicmeta><navtitle>Juniors</navtitle><shortdesc>Junior members or players, typically children in club, sports or activity settings.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-122" href="../audience/aud-122.dita">
      <topicmeta><navtitle>Under-age groups (under 18s and similar)</navtitle><shortdesc>Services for people below an upper age limit, such as under 18s, under 16s or under 10s, sometimes needing adult supervision.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-130" href="../audience/aud-130.dita">
      <topicmeta><navtitle>Young people aged around 10 to 19</navtitle><shortdesc>Services for young people with a stated age range, usually early teens to about 18 or 19.</shortdesc></topicmeta>
    </subjectdef>
  </subjectdef>
  <subjectdef keys="aud-g08" href="../audience/aud-g08.dita">
    <topicmeta><navtitle>People with disabilities or additional needs</navtitle><shortdesc>Children and adults with learning, physical, sensory or neurodevelopmental disabilities and special educational needs, and their families.</shortdesc></topicmeta>
    <subjectdef keys="aud-004" href="../audience/aud-004.dita">
      <topicmeta><navtitle>Neurodivergent people and their families</navtitle><shortdesc>Neurodivergent children, young people and adults, including those with autism, ADHD and related conditions, and the parents or carers who support them.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-013" href="../audience/aud-013.dita">
      <topicmeta><navtitle>Autistic people</navtitle><shortdesc>Autistic people of any age, including those on the autistic spectrum or with Asperger Syndrome, and their families.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-028" href="../audience/aud-028.dita">
      <topicmeta><navtitle>Families of children with SEND up to 25</navtitle><shortdesc>Families or parents of a child or young person, up to age 25, who has special educational needs or disabilities.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-044" href="../audience/aud-044.dita">
      <topicmeta><navtitle>People with learning disabilities</navtitle><shortdesc>People with a learning disability or learning difficulty, of any age but mostly adults.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-045" href="../audience/aud-045.dita">
      <topicmeta><navtitle>Adults with learning disabilities and autism</navtitle><shortdesc>Adults with a learning disability and/or autism, sometimes with other conditions such as physical disability or complex needs, often for care and housing.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-063" href="../audience/aud-063.dita">
      <topicmeta><navtitle>People with disabilities or health conditions</navtitle><shortdesc>People with a disability or a physical or mental health condition, often listed together with other barriers such as neurodiversity or barriers to work.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-064" href="../audience/aud-064.dita">
      <topicmeta><navtitle>Adults with learning and physical disabilities</navtitle><shortdesc>Adults (sometimes teenagers) who have both a learning disability and a physical disability, including those with severe needs who require accommodation and personal care.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-070" href="../audience/aud-070.dita">
      <topicmeta><navtitle>People with sight loss or sensory impairment</navtitle><shortdesc>People who are blind, partially sighted or have other vision loss, along with people with sight and/or hearing loss or sensory impairments generally.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-091" href="../audience/aud-091.dita">
      <topicmeta><navtitle>Children with disabilities or additional needs</navtitle><shortdesc>Children and young people with a disability, special needs or a named condition such as Down's syndrome or cerebral palsy, and sometimes their families.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-114" href="../audience/aud-114.dita">
      <topicmeta><navtitle>Children and young people with SEND</navtitle><shortdesc>Children and young people, often up to age 25, described in full as having special educational needs and disabilities, including those who receive support in school or early years.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-115" href="../audience/aud-115.dita">
      <topicmeta><navtitle>Children and families with SEND</navtitle><shortdesc>Children, young people up to 25 and their families described using the abbreviation SEND (or SEN).</shortdesc></topicmeta>
    </subjectdef>
  </subjectdef>
  <subjectdef keys="aud-g10" href="../audience/aud-g10.dita">
    <topicmeta><navtitle>Parents and carers</navtitle><shortdesc>Parents, guardians and carers of children, with some couples and partners.</shortdesc></topicmeta>
    <subjectdef keys="aud-026" href="../audience/aud-026.dita">
      <topicmeta><navtitle>Couples and partners</navtitle><shortdesc>Couples, partners, spouses and people looking at relationships, including friends and partners of group members.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-134" href="../audience/aud-134.dita">
      <topicmeta><navtitle>Parents and carers</navtitle><shortdesc>Parents, carers and other family adults (such as grandparents or childminders) who look after children, including parent carers of children with additional needs.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-143" href="../audience/aud-143.dita">
      <topicmeta><navtitle>Parents and guardians</navtitle><shortdesc>Parents and guardians as a group, including single parents, fathers and parents who are worried, isolated or seeking company.</shortdesc></topicmeta>
    </subjectdef>
  </subjectdef>
  <subjectdef keys="aud-g12" href="../audience/aud-g12.dita">
    <topicmeta><navtitle>People affected by crime or abuse</navtitle><shortdesc>Offenders, victims of crime and survivors of domestic, sexual or other abuse.</shortdesc></topicmeta>
    <subjectdef keys="aud-002" href="../audience/aud-002.dita">
      <topicmeta><navtitle>People in or affected by criminal justice</navtitle><shortdesc>Offenders, ex-offenders and people in prison or on probation, together with victims of crime and their families.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-003" href="../audience/aud-003.dita">
      <topicmeta><navtitle>People affected by domestic or sexual abuse</navtitle><shortdesc>Survivors and victims of domestic abuse, sexual violence, stalking or childhood abuse, and those worried about someone else being abused.</shortdesc></topicmeta>
    </subjectdef>
  </subjectdef>
  <subjectdef keys="aud-g14" href="../audience/aud-g14.dita">
    <topicmeta><navtitle>Older people and carers</navtitle><shortdesc>Older people, including those with dementia, and the unpaid carers and families who support them.</shortdesc></topicmeta>
    <subjectdef keys="aud-007" href="../audience/aud-007.dita">
      <topicmeta><navtitle>Older people</navtitle><shortdesc>People described by age as older, typically over 55, 60, 65 or 75, including those with age-related frailty or conditions.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-011" href="../audience/aud-011.dita">
      <topicmeta><navtitle>People living with dementia</navtitle><shortdesc>People who have dementia or are affected by it, including those with advanced dementia.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-019" href="../audience/aud-019.dita">
      <topicmeta><navtitle>Carers together with family and friends</navtitle><shortdesc>Services open to carers along with the family members and friends around them, often listed as a combined group, including young and young adult carers.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-037" href="../audience/aud-037.dita">
      <topicmeta><navtitle>Carers</navtitle><shortdesc>Unpaid or informal carers described simply as carers, including foster carers, former carers and partners who care.</shortdesc></topicmeta>
    </subjectdef>
  </subjectdef>
  <subjectdef keys="aud-g18" href="../audience/aud-g18.dita">
    <topicmeta><navtitle>Young children and their families</navtitle><shortdesc>Babies, toddlers and pre-school children, and families with children.</shortdesc></topicmeta>
    <subjectdef keys="aud-069" href="../audience/aud-069.dita">
      <topicmeta><navtitle>Pre-school children</navtitle><shortdesc>Children below school age, often with their parents, and the early years settings that serve them.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-110" href="../audience/aud-110.dita">
      <topicmeta><navtitle>Babies and toddlers</navtitle><shortdesc>Babies and toddlers, typically from birth to around five years, as the people the activity is for.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-132" href="../audience/aud-132.dita">
      <topicmeta><navtitle>Families with children</navtitle><shortdesc>Families with children or young people up to the late teens, including young families, as a whole household audience.</shortdesc></topicmeta>
    </subjectdef>
  </subjectdef>
  <subjectdef keys="aud-g20" href="../audience/aud-g20.dita">
    <topicmeta><navtitle>People wanting to get active</navtitle><shortdesc>People of any fitness level, including those nervous about exercise, who want gentle or inclusive physical activity.</shortdesc></topicmeta>
    <subjectdef keys="aud-154" href="../audience/aud-154.dita">
      <topicmeta><navtitle>People returning to exercise gently</navtitle><shortdesc>People who are out of practice, low in fitness or nervous about exercise and want an easy or low impact way back into activity.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-156" href="../audience/aud-156.dita">
      <topicmeta><navtitle>All ages and fitness levels</navtitle><shortdesc>Activities stated as suitable for people of any fitness level, age or ability, including beginners.</shortdesc></topicmeta>
    </subjectdef>
  </subjectdef>
  <subjectdef keys="aud-g30" href="../audience/aud-g30.dita">
    <topicmeta><navtitle>People in or seeking work</navtitle><shortdesc>Unemployed people and jobseekers, along with professionals who deliver or refer to services.</shortdesc></topicmeta>
    <subjectdef keys="aud-123" href="../audience/aud-123.dita">
      <topicmeta><navtitle>Professionals and practitioners</navtitle><shortdesc>Workers and practitioners who use or deliver a service in a professional capacity, such as referrers, support workers, facilitators and other professionals.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-135" href="../audience/aud-135.dita">
      <topicmeta><navtitle>People out of work or seeking work</navtitle><shortdesc>Unemployed and economically inactive people, jobseekers and people who have lost their job or face barriers to getting into work.</shortdesc></topicmeta>
    </subjectdef>
  </subjectdef>
  <subjectdef keys="aud-g-other" href="../audience/aud-g-other.dita">
    <topicmeta><navtitle>Categories not yet in a group</navtitle><shortdesc>Categories that sit alone in the clustering hierarchy.</shortdesc></topicmeta>
    <subjectdef keys="aud-000" href="../audience/aud-000.dita">
      <topicmeta><navtitle>Armed forces community</navtitle><shortdesc>Serving personnel, reservists, cadets, veterans and their families or dependants.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-006" href="../audience/aud-006.dita">
      <topicmeta><navtitle>Women</navtitle><shortdesc>Women and ladies of any age or background, including women's groups and women with higher levels of need.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-022" href="../audience/aud-022.dita">
      <topicmeta><navtitle>People going through menopause</navtitle><shortdesc>People experiencing menopause or perimenopause and their partners, along with related women's health issues such as pelvic floor weakness.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-030" href="../audience/aud-030.dita">
      <topicmeta><navtitle>Registered with a local GP or NHS staff</navtitle><shortdesc>People eligible through being registered with a GP in a named area or scheme, together with NHS staff and a few NHS-related groups.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-031" href="../audience/aud-031.dita">
      <topicmeta><navtitle>People affected by OCD</navtitle><shortdesc>People with obsessive-compulsive disorder or closely related conditions (such as body-focused repetitive behaviours), along with their partners, parents and loved ones.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-040" href="../audience/aud-040.dita">
      <topicmeta><navtitle>Players and participants of all levels</navtitle><shortdesc>People who take part in a sport or game and welcome players of any age, skill or experience level, from beginners to experienced.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-042" href="../audience/aud-042.dita">
      <topicmeta><navtitle>LGBTQ+ and trans people</navtitle><shortdesc>Lesbian, gay, bisexual, trans, non-binary and queer people, including young people and their friends, partners or family.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-052" href="../audience/aud-052.dita">
      <topicmeta><navtitle>Gardeners and nature lovers</navtitle><shortdesc>People interested in gardening, plants, allotments and green activities.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-054" href="../audience/aud-054.dita">
      <topicmeta><navtitle>People with limited mobility</navtitle><shortdesc>People who find it hard to move around, because of disability, illness, age or risk of falls, including wheelchair users.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-065" href="../audience/aud-065.dita">
      <topicmeta><navtitle>Breastfeeding mothers</navtitle><shortdesc>Mothers and families who are breastfeeding or wish to breastfeed, including those combination feeding or expressing.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-071" href="../audience/aud-071.dita">
      <topicmeta><navtitle>Deaf and hard of hearing people</navtitle><shortdesc>Deaf people and people with hearing loss, tinnitus or NHS hearing aids, including those needing hearing aid care.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-126" href="../audience/aud-126.dita">
      <topicmeta><navtitle>Craft enthusiasts and stitchers</navtitle><shortdesc>People who enjoy crafts such as embroidery, knitting and lace, from complete beginners to experienced makers.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-127" href="../audience/aud-127.dita">
      <topicmeta><navtitle>Businesses and business owners</navtitle><shortdesc>Businesses of any size or stage, including start-ups, self-employed people and business owners, as the audience for support.</shortdesc></topicmeta>
    </subjectdef>
  </subjectdef>
</subjectScheme>
