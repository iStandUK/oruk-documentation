<subjectScheme id="audience" xml:lang="en-GB">
  <title>ORUK audience (draft from the pilot)</title>
  <subjectdef keys="aud-g00" href="../audience/aud-g00.dita">
    <topicmeta><navtitle>People with long-term health conditions</navtitle><shortdesc>People living with a chronic, progressive, painful or life-limiting physical illness or injury, or recovering from one, and their families.</shortdesc></topicmeta>
    <subjectdef keys="aud-011" href="../audience/aud-011.dita">
      <topicmeta><navtitle>Stroke and brain injury survivors</navtitle><shortdesc>People who have had a stroke, TIA or acquired brain injury, including those with related communication difficulties such as aphasia, and those close to them.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-018" href="../audience/aud-018.dita">
      <topicmeta><navtitle>People with arthritis or joint pain</navtitle><shortdesc>People living with arthritis, painful or stiff joints and similar musculoskeletal complaints.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-019" href="../audience/aud-019.dita">
      <topicmeta><navtitle>People with fibromyalgia or persistent pain</navtitle><shortdesc>People living with fibromyalgia, ME/CFS or other persistent pain and fatigue conditions.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-023" href="../audience/aud-023.dita">
      <topicmeta><navtitle>People with multiple sclerosis</navtitle><shortdesc>People living with multiple sclerosis (MS), and their carers, sometimes alongside other progressive or fatiguing conditions.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-026" href="../audience/aud-026.dita">
      <topicmeta><navtitle>People with Parkinson's and similar conditions</navtitle><shortdesc>People living with Parkinson's disease or related progressive neurological conditions such as motor neurone disease and Huntington's, and their families.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-030" href="../audience/aud-030.dita">
      <topicmeta><navtitle>People recovering from injury or surgery</navtitle><shortdesc>People regaining strength or movement after an injury, operation or illness.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-032" href="../audience/aud-032.dita">
      <topicmeta><navtitle>People with a terminal or life-limiting illness</navtitle><shortdesc>People with an incurable or advanced illness who need palliative or hospice care, and their families.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-033" href="../audience/aud-033.dita">
      <topicmeta><navtitle>People affected by cancer</navtitle><shortdesc>People diagnosed with cancer, living beyond it, or bereaved by it, and their families.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-050" href="../audience/aud-050.dita">
      <topicmeta><navtitle>People with long-term health conditions</navtitle><shortdesc>People living with any ongoing or chronic medical condition, described in general terms rather than by a named illness.</shortdesc></topicmeta>
    </subjectdef>
  </subjectdef>
  <subjectdef keys="aud-g01" href="../audience/aud-g01.dita">
    <topicmeta><navtitle>Patients and health professionals</navtitle><shortdesc>Patients and residents using NHS and social care services, including those wanting to complain, and the clinicians and staff who deliver or refer to them.</shortdesc></topicmeta>
    <subjectdef keys="aud-014" href="../audience/aud-014.dita">
      <topicmeta><navtitle>Patients and GP-registered residents</navtitle><shortdesc>People eligible for a service because they are patients of a local GP surgery or health service, or live in a particular health area.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-059" href="../audience/aud-059.dita">
      <topicmeta><navtitle>People wanting to complain about care</navtitle><shortdesc>People who want to raise a complaint or concern about NHS or social care services, or need help doing so.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-078" href="../audience/aud-078.dita">
      <topicmeta><navtitle>Health and care professionals</navtitle><shortdesc>Clinicians, NHS staff and other health and social care workers who use or refer to a service.</shortdesc></topicmeta>
    </subjectdef>
  </subjectdef>
  <subjectdef keys="aud-g02" href="../audience/aud-g02.dita">
    <topicmeta><navtitle>People in vulnerable circumstances</navtitle><shortdesc>People who are vulnerable, isolated, in crisis, homeless, seeking asylum or have complex needs, without a specific health condition named.</shortdesc></topicmeta>
    <subjectdef keys="aud-020" href="../audience/aud-020.dita">
      <topicmeta><navtitle>Vulnerable and isolated people</navtitle><shortdesc>People described as vulnerable, at risk or hidden in their community, without a specific condition or circumstance named.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-024" href="../audience/aud-024.dita">
      <topicmeta><navtitle>Refugees and asylum seekers</navtitle><shortdesc>People seeking asylum, newly granted refugee status or otherwise migrating with insecure status, and those supporting them.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-034" href="../audience/aud-034.dita">
      <topicmeta><navtitle>People who are homeless or at risk</navtitle><shortdesc>People sleeping rough, in temporary accommodation or in precarious housing, or at risk of becoming homeless.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-037" href="../audience/aud-037.dita">
      <topicmeta><navtitle>Lonely or isolated people</navtitle><shortdesc>People who feel lonely or socially isolated and want company or connection.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-045" href="../audience/aud-045.dita">
      <topicmeta><navtitle>People in crisis</navtitle><shortdesc>People, families or children facing an acute crisis or urgent situation who need immediate help.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-066" href="../audience/aud-066.dita">
      <topicmeta><navtitle>People with additional or complex needs</navtitle><shortdesc>People described only as having extra, complex or varied support or access needs, without a named condition.</shortdesc></topicmeta>
    </subjectdef>
  </subjectdef>
  <subjectdef keys="aud-g03" href="../audience/aud-g03.dita">
    <topicmeta><navtitle>Local area residents</navtitle><shortdesc>People living in a named local area such as North Lincolnshire or Dorset, or the whole local community with no particular group singled out.</shortdesc></topicmeta>
    <subjectdef keys="aud-009" href="../audience/aud-009.dita">
      <topicmeta><navtitle>North Lincolnshire residents</navtitle><shortdesc>People, families and library members living in North Lincolnshire and nearby Lincolnshire areas.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-152" href="../audience/aud-152.dita">
      <topicmeta><navtitle>Dorset residents</navtitle><shortdesc>People living in Dorset or a named part of Dorset, including by postcode area.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-155" href="../audience/aud-155.dita">
      <topicmeta><navtitle>Everyone in the local community</navtitle><shortdesc>The whole local community, including villagers and community members, with no particular group singled out.</shortdesc></topicmeta>
    </subjectdef>
  </subjectdef>
  <subjectdef keys="aud-g04" href="../audience/aud-g04.dita">
    <topicmeta><navtitle>People with mental health conditions</navtitle><shortdesc>People experiencing mental health difficulties, including women in crisis and those with OCD and related conditions, and their families.</shortdesc></topicmeta>
    <subjectdef keys="aud-056" href="../audience/aud-056.dita">
      <topicmeta><navtitle>Women with mental health problems</navtitle><shortdesc>Women experiencing mental health difficulties, crisis or self-harm.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-058" href="../audience/aud-058.dita">
      <topicmeta><navtitle>People with OCD and related conditions</navtitle><shortdesc>People affected by obsessive-compulsive disorder and related conditions such as body dysmorphia, phobias or hair-pulling, and their families.</shortdesc></topicmeta>
    </subjectdef>
  </subjectdef>
  <subjectdef keys="aud-g05" href="../audience/aud-g05.dita">
    <topicmeta><navtitle>Workers and jobseekers</navtitle><shortdesc>People in or looking for work, including professionals and staff who use or refer to a service and unemployed people facing barriers to employment.</shortdesc></topicmeta>
    <subjectdef keys="aud-124" href="../audience/aud-124.dita">
      <topicmeta><navtitle>Professionals and staff</navtitle><shortdesc>Workers, service providers and professionals of any kind who use, run or refer to a service.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-138" href="../audience/aud-138.dita">
      <topicmeta><navtitle>Unemployed people and jobseekers</navtitle><shortdesc>People who are out of work, have lost a job or are looking for work, including those facing barriers to employment.</shortdesc></topicmeta>
    </subjectdef>
  </subjectdef>
  <subjectdef keys="aud-g06" href="../audience/aud-g06.dita">
    <topicmeta><navtitle>People with disabilities</navtitle><shortdesc>People with sensory, physical, learning or neurodevelopmental disabilities or impairments, including children with special educational needs, and those described broadly as having a disability.</shortdesc></topicmeta>
    <subjectdef keys="aud-012" href="../audience/aud-012.dita">
      <topicmeta><navtitle>People with sight loss</navtitle><shortdesc>Blind, partially sighted or visually impaired people of any age, including those with dual sight and hearing loss, and their parents.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-013" href="../audience/aud-013.dita">
      <topicmeta><navtitle>Deaf and hard of hearing people</navtitle><shortdesc>Deaf people, people with hearing loss, and hearing aid wearers.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-017" href="../audience/aud-017.dita">
      <topicmeta><navtitle>Autistic people</navtitle><shortdesc>Autistic children, young people and adults, including those with Asperger's, and their families.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-025" href="../audience/aud-025.dita">
      <topicmeta><navtitle>People with a disability or health condition</navtitle><shortdesc>People described broadly as having a disability, long-term health condition or mix of physical, mental and cognitive conditions.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-043" href="../audience/aud-043.dita">
      <topicmeta><navtitle>People with limited mobility</navtitle><shortdesc>People who find it hard to move around because of age, illness or disability, without necessarily using a wheelchair.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-061" href="../audience/aud-061.dita">
      <topicmeta><navtitle>Neurodivergent people</navtitle><shortdesc>People who are neurodivergent, including ADHD, autism, dyslexia and other learning or sensory processing differences, especially children and young people.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-069" href="../audience/aud-069.dita">
      <topicmeta><navtitle>All ages and abilities welcome</navtitle><shortdesc>Open to people of any age combined with any ability, level or background, with no one targeted.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-075" href="../audience/aud-075.dita">
      <topicmeta><navtitle>Adults with disabilities</navtitle><shortdesc>Disabled adults, including those with physical, learning or profound and multiple disabilities, and some groups that also include children.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-084" href="../audience/aud-084.dita">
      <topicmeta><navtitle>Adults with learning disabilities</navtitle><shortdesc>Adults and young adults with a learning disability or learning difficulty, including dyslexia.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-126" href="../audience/aud-126.dita">
      <topicmeta><navtitle>Children with special educational needs (SEND)</navtitle><shortdesc>Children and young people up to 25 who have special educational needs or disabilities, including those needing communication aids or extra support at school.</shortdesc></topicmeta>
    </subjectdef>
  </subjectdef>
  <subjectdef keys="aud-g08" href="../audience/aud-g08.dita">
    <topicmeta><navtitle>People wanting social connection</navtitle><shortdesc>People who want to make friends, meet new people or attend together with partners and friends, including club members and non-members.</shortdesc></topicmeta>
    <subjectdef keys="aud-151" href="../audience/aud-151.dita">
      <topicmeta><navtitle>Couples, partners and friends</navtitle><shortdesc>Couples, partners and friends who attend together or want help with relationships.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-163" href="../audience/aud-163.dita">
      <topicmeta><navtitle>People wanting to meet new people</navtitle><shortdesc>People who want to make friends, widen their social circle or get out and be sociable.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-166" href="../audience/aud-166.dita">
      <topicmeta><navtitle>Members and non-members</navtitle><shortdesc>Club or group members, and sometimes non-members, as the people a session is open to.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-174" href="../audience/aud-174.dita">
      <topicmeta><navtitle>Anyone or unspecified</navtitle><shortdesc>Catch-all entries such as people, anyone, all or mixed, giving no particular target group.</shortdesc></topicmeta>
    </subjectdef>
  </subjectdef>
  <subjectdef keys="aud-g09" href="../audience/aud-g09.dita">
    <topicmeta><navtitle>Carers and families</navtitle><shortdesc>Parents, carers, young carers and family or friends who look after someone, including parents of children with special needs.</shortdesc></topicmeta>
    <subjectdef keys="aud-001" href="../audience/aud-001.dita">
      <topicmeta><navtitle>Older people</navtitle><shortdesc>People aged roughly 50 or 60 and over, or described as older or elderly, including older women and men.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-083" href="../audience/aud-083.dita">
      <topicmeta><navtitle>Parents and carers</navtitle><shortdesc>Parents, grandparents, carers and childminders looking after children.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-088" href="../audience/aud-088.dita">
      <topicmeta><navtitle>Young carers and young adult carers</navtitle><shortdesc>Children, teenagers and young adults who look after a family member, and their families.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-111" href="../audience/aud-111.dita">
      <topicmeta><navtitle>Family, friends and carers</navtitle><shortdesc>Relatives, friends and carers who support someone, named together as a group.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-115" href="../audience/aud-115.dita">
      <topicmeta><navtitle>Carers</navtitle><shortdesc>People who provide unpaid care or support to a relative or friend, including former and foster carers, sometimes alongside the person they care for.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-127" href="../audience/aud-127.dita">
      <topicmeta><navtitle>Parents of children with SEND</navtitle><shortdesc>Parents and carers of disabled children or children with special educational needs, including autism and ADHD.</shortdesc></topicmeta>
    </subjectdef>
  </subjectdef>
  <subjectdef keys="aud-g10" href="../audience/aud-g10.dita">
    <topicmeta><navtitle>People keeping fit and active</navtitle><shortdesc>People of any fitness level who want to walk, run, cycle or start or return to exercise.</shortdesc></topicmeta>
    <subjectdef keys="aud-016" href="../audience/aud-016.dita">
      <topicmeta><navtitle>Walkers and walking ability levels</navtitle><shortdesc>People joining walking groups, described by walking fitness or aids used.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-095" href="../audience/aud-095.dita">
      <topicmeta><navtitle>All fitness levels welcome</navtitle><shortdesc>Sessions open to people at any level of fitness or ability, from beginner to advanced.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-096" href="../audience/aud-096.dita">
      <topicmeta><navtitle>People starting or returning to exercise</navtitle><shortdesc>People who are new to exercise, out of practice or wanting to keep fit and active.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-108" href="../audience/aud-108.dita">
      <topicmeta><navtitle>Runners, cyclists and endurance athletes</navtitle><shortdesc>People who run, cycle or swim, from beginners to seasoned competitors.</shortdesc></topicmeta>
    </subjectdef>
  </subjectdef>
  <subjectdef keys="aud-g11" href="../audience/aud-g11.dita">
    <topicmeta><navtitle>People affected by abuse or crime</navtitle><shortdesc>Survivors of domestic or sexual abuse and people in the criminal justice system, including offenders, prisoners and their families.</shortdesc></topicmeta>
    <subjectdef keys="aud-028" href="../audience/aud-028.dita">
      <topicmeta><navtitle>Victims and survivors of domestic or sexual abuse</navtitle><shortdesc>People of any gender and age who have experienced domestic abuse, sexual violence or stalking, and those concerned about them.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-053" href="../audience/aud-053.dita">
      <topicmeta><navtitle>People in the criminal justice system</navtitle><shortdesc>Offenders, ex-offenders, prisoners and their families, along with some victims of serious crime.</shortdesc></topicmeta>
    </subjectdef>
  </subjectdef>
  <subjectdef keys="aud-g12" href="../audience/aud-g12.dita">
    <topicmeta><navtitle>Babies, children and parents</navtitle><shortdesc>Babies, toddlers, pre-school and school-age children and young people, and the parents who bring them.</shortdesc></topicmeta>
    <subjectdef keys="aud-047" href="../audience/aud-047.dita">
      <topicmeta><navtitle>Pre-school children</navtitle><shortdesc>Babies, toddlers and children before school age, and their parents or early years settings.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-055" href="../audience/aud-055.dita">
      <topicmeta><navtitle>Children and young people</navtitle><shortdesc>Children and young people up to about 18, in broad age ranges, plus some disadvantaged or at-risk young people.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-093" href="../audience/aud-093.dita">
      <topicmeta><navtitle>Babies and toddlers</navtitle><shortdesc>Babies and toddlers, up to about school entry, and the mums who bring them.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-117" href="../audience/aud-117.dita">
      <topicmeta><navtitle>School-age children</navtitle><shortdesc>Children of primary school age or attending a particular school, and some at nursery age leading up to school.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-121" href="../audience/aud-121.dita">
      <topicmeta><navtitle>Parents of babies and toddlers</navtitle><shortdesc>Parents, carers or grandparents looking after a baby, toddler or pre-schooler (roughly birth to 4 years), usually attending together with the child.</shortdesc></topicmeta>
    </subjectdef>
  </subjectdef>
  <subjectdef keys="aud-g13" href="../audience/aud-g13.dita">
    <topicmeta><navtitle>Beginners</navtitle><shortdesc>People who are new to an activity such as dance, exercise, yoga or any other pursuit, or described simply as beginners or novices.</shortdesc></topicmeta>
    <subjectdef keys="aud-109" href="../audience/aud-109.dita">
      <topicmeta><navtitle>Beginners to dance and exercise</navtitle><shortdesc>People who are new to, or have only basic experience of, a physical activity such as dance, group exercise, Pilates, walking, running or strength training.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-110" href="../audience/aud-110.dita">
      <topicmeta><navtitle>Yoga newcomers and practitioners</navtitle><shortdesc>People new to, returning to, or experienced in yoga, including those wanting a slower-paced mindful style of practice.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-157" href="../audience/aud-157.dita">
      <topicmeta><navtitle>Beginners (any activity)</navtitle><shortdesc>People described simply as beginners or novices, adult or otherwise, without a specific activity or wider skill range.</shortdesc></topicmeta>
    </subjectdef>
  </subjectdef>
  <subjectdef keys="aud-g14" href="../audience/aud-g14.dita">
    <topicmeta><navtitle>People in financial need</navtitle><shortdesc>People and households struggling with money, debt or the cost of living, or needing emergency food and other basic support.</shortdesc></topicmeta>
    <subjectdef keys="aud-086" href="../audience/aud-086.dita">
      <topicmeta><navtitle>People in financial hardship</navtitle><shortdesc>People or households struggling with money, debt, the cost of living or a sudden loss of income.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-087" href="../audience/aud-087.dita">
      <topicmeta><navtitle>People needing food or general support</navtitle><shortdesc>People in need, mainly those referred to or using a food bank or needing emergency food, plus generic wording about people or families in need.</shortdesc></topicmeta>
    </subjectdef>
  </subjectdef>
  <subjectdef keys="aud-g16" href="../audience/aud-g16.dita">
    <topicmeta><navtitle>Families and loved ones</navtitle><shortdesc>Whole families, and relatives, friends and partners who are welcomed or supported alongside the main service user.</shortdesc></topicmeta>
    <subjectdef keys="aud-130" href="../audience/aud-130.dita">
      <topicmeta><navtitle>Families</navtitle><shortdesc>Whole families or family units, with the family itself as the audience rather than a particular age of child.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-150" href="../audience/aud-150.dita">
      <topicmeta><navtitle>Family, friends and loved ones</navtitle><shortdesc>Family members, friends, partners and others close to a person, who are welcomed or supported alongside the main service user.</shortdesc></topicmeta>
    </subjectdef>
  </subjectdef>
  <subjectdef keys="aud-g17" href="../audience/aud-g17.dita">
    <topicmeta><navtitle>People affected by addiction</navtitle><shortdesc>People with problems with drugs, alcohol or gambling, and the family and friends harmed by someone else's use.</shortdesc></topicmeta>
    <subjectdef keys="aud-007" href="../audience/aud-007.dita">
      <topicmeta><navtitle>People affected by drugs or alcohol</navtitle><shortdesc>People who use drugs or alcohol problematically, are dependent or recovering, or are affected by someone else's use.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-008" href="../audience/aud-008.dita">
      <topicmeta><navtitle>People affected by gambling</navtitle><shortdesc>People with a gambling problem and the family members, partners or friends harmed by someone else's gambling.</shortdesc></topicmeta>
    </subjectdef>
  </subjectdef>
  <subjectdef keys="aud-g24" href="../audience/aud-g24.dita">
    <topicmeta><navtitle>Pregnant people and new mothers</navtitle><shortdesc>People who are pregnant, have recently given birth or lost a baby, and mothers who are breastfeeding or want to breastfeed.</shortdesc></topicmeta>
    <subjectdef keys="aud-101" href="../audience/aud-101.dita">
      <topicmeta><navtitle>Pregnant people and new parents</navtitle><shortdesc>People who are pregnant, trying to conceive, have recently given birth, or have lost a baby, including perinatal mental health needs.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-105" href="../audience/aud-105.dita">
      <topicmeta><navtitle>Breastfeeding mothers</navtitle><shortdesc>Mothers who are breastfeeding or want to breastfeed, including breastfeeding families.</shortdesc></topicmeta>
    </subjectdef>
  </subjectdef>
  <subjectdef keys="aud-g26" href="../audience/aud-g26.dita">
    <topicmeta><navtitle>People affected by dementia</navtitle><shortdesc>People living with dementia or memory problems, including those without a diagnosis, and the family and carers who support them.</shortdesc></topicmeta>
    <subjectdef keys="aud-002" href="../audience/aud-002.dita">
      <topicmeta><navtitle>Carers of people with dementia</navtitle><shortdesc>Family members and other carers looking after someone with dementia, including sessions for the person and their carer together.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-005" href="../audience/aud-005.dita">
      <topicmeta><navtitle>People living with dementia</navtitle><shortdesc>People with a diagnosis of dementia or Alzheimer's, and dementia-friendly groups.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-006" href="../audience/aud-006.dita">
      <topicmeta><navtitle>People with memory problems</navtitle><shortdesc>People with memory loss, memory concerns or dementia, including those worried about their memory and without a diagnosis.</shortdesc></topicmeta>
    </subjectdef>
  </subjectdef>
  <subjectdef keys="aud-g29" href="../audience/aud-g29.dita">
    <topicmeta><navtitle>Women and girls</navtitle><shortdesc>Women and girls of all ages and backgrounds, including women-only groups and young women.</shortdesc></topicmeta>
    <subjectdef keys="aud-003" href="../audience/aud-003.dita">
      <topicmeta><navtitle>Women</navtitle><shortdesc>Women and ladies of all ages and backgrounds, including women-only groups and women from particular communities.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-004" href="../audience/aud-004.dita">
      <topicmeta><navtitle>Girls and young women</navtitle><shortdesc>Girls and young women, usually of school age or up to their mid-twenties.</shortdesc></topicmeta>
    </subjectdef>
  </subjectdef>
  <subjectdef keys="aud-g33" href="../audience/aud-g33.dita">
    <topicmeta><navtitle>People by age band</navtitle><shortdesc>People described mainly by age or age range, such as adults, teenagers, juniors, people over a minimum age, or everyone of all ages.</shortdesc></topicmeta>
    <subjectdef keys="aud-060" href="../audience/aud-060.dita">
      <topicmeta><navtitle>Adults</navtitle><shortdesc>Adults, usually stated with a minimum age of 16, 18 or 19, including male adults.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-079" href="../audience/aud-079.dita">
      <topicmeta><navtitle>People of all ages</navtitle><shortdesc>Services open to everyone regardless of age, from young children to older people.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-080" href="../audience/aud-080.dita">
      <topicmeta><navtitle>Juniors</navtitle><shortdesc>Junior members or players, typically school-age children (around 4 to 16), as used by clubs and sports groups.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-092" href="../audience/aud-092.dita">
      <topicmeta><navtitle>Adults and children together</navtitle><shortdesc>Services open to both adults and children or teens, naming the two groups side by side.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-097" href="../audience/aud-097.dita">
      <topicmeta><navtitle>People aged 16 and over</navtitle><shortdesc>People whose only stated requirement is a minimum age of 16.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-098" href="../audience/aud-098.dita">
      <topicmeta><navtitle>Ages 4 to 14 and upwards</navtitle><shortdesc>People above a stated minimum age below 16 (for example 4, 8, 12 or 13) with no upper age limit.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-104" href="../audience/aud-104.dita">
      <topicmeta><navtitle>People aged 18 and over</navtitle><shortdesc>People whose only stated requirement is being 18 or older.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-125" href="../audience/aud-125.dita">
      <topicmeta><navtitle>Teenagers</navtitle><shortdesc>Teens and teenagers, including preteens, teens with a particular condition, and teens alongside adults.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-131" href="../audience/aud-131.dita">
      <topicmeta><navtitle>Boys and girls</navtitle><shortdesc>Boys, or boys and girls, of school age, often given with an age range or school years.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-140" href="../audience/aud-140.dita">
      <topicmeta><navtitle>Children and teens by age range</navtitle><shortdesc>Children and teenagers described only by an age band such as 11-18 or 8-11, or by school year.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-154" href="../audience/aud-154.dita">
      <topicmeta><navtitle>Young people aged 8 to 18</navtitle><shortdesc>Young people described as such with an age band mostly between 8 and 18, including any young person.</shortdesc></topicmeta>
    </subjectdef>
  </subjectdef>
  <subjectdef keys="aud-g-other" href="../audience/aud-g-other.dita">
    <topicmeta><navtitle>Categories not yet in a group</navtitle><shortdesc>Categories that sit alone in the clustering hierarchy.</shortdesc></topicmeta>
    <subjectdef keys="aud-000" href="../audience/aud-000.dita">
      <topicmeta><navtitle>People going through menopause</navtitle><shortdesc>People experiencing perimenopause, menopause or post-menopause, and their partners.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-010" href="../audience/aud-010.dita">
      <topicmeta><navtitle>People with eating disorders</navtitle><shortdesc>People with a diagnosed or suspected eating disorder or compulsive eating, with a few women-only healthy-living goals mixed in.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-042" href="../audience/aud-042.dita">
      <topicmeta><navtitle>LGBTQ+ people and their families</navtitle><shortdesc>Lesbian, gay, bisexual, trans and other LGBTQ+ people, including young people, and their parents, families and friends.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-046" href="../audience/aud-046.dita">
      <topicmeta><navtitle>People with a hobby or heritage interest</navtitle><shortdesc>People interested in gardening, nature, history, heritage or the arts, including local historians and supporters of heritage bodies.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-065" href="../audience/aud-065.dita">
      <topicmeta><navtitle>Volunteers and not-for-profit groups</navtitle><shortdesc>Volunteers and would-be volunteers, together with charities, community groups and other non-profit organisations and their staff.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-071" href="../audience/aud-071.dita">
      <topicmeta><navtitle>Bereaved people</navtitle><shortdesc>People who are grieving after the death of a partner, relative or loved one, including sudden and traumatic bereavement.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-090" href="../audience/aud-090.dita">
      <topicmeta><navtitle>Businesses and employers</navtitle><shortdesc>Businesses, companies, the self-employed and employers, including start-ups and small local firms.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-113" href="../audience/aud-113.dita">
      <topicmeta><navtitle>Craft and sewing enthusiasts</navtitle><shortdesc>People who knit, sew, embroider or do other crafts, from complete beginners to experienced makers.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="aud-146" href="../audience/aud-146.dita">
      <topicmeta><navtitle>Players of all levels</navtitle><shortdesc>Sports and games players, from beginners to experienced, in clubs and teams.</shortdesc></topicmeta>
    </subjectdef>
  </subjectdef>
</subjectScheme>
