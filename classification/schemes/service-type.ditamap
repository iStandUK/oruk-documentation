<subjectScheme id="service-type" xml:lang="en-GB">
  <title>ORUK service type (draft from the pilot)</title>
  <subjectdef keys="svc-g00" href="../service-type/svc-g00.dita">
    <topicmeta><navtitle>Children's clubs, childcare and SEND support</navtitle><shortdesc>Clubs, sessions, childcare and support for babies, children and young people, including after-school and youth groups, nurseries, toddler groups and help for children with special needs.</shortdesc></topicmeta>
    <subjectdef keys="svc-043" href="../service-type/svc-043.dita">
      <topicmeta><navtitle>Support for children with SEND</navtitle><shortdesc>Support, learning help, resources and information for children and young people with special educational needs, disabilities or conditions such as autism, ADHD, dyslexia or learning disabilities.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-069" href="../service-type/svc-069.dita">
      <topicmeta><navtitle>After-school clubs</navtitle><shortdesc>Clubs and sessions that school-age children attend after the school day, such as after-school clubs, homework clubs and evening sessions.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-070" href="../service-type/svc-070.dita">
      <topicmeta><navtitle>Youth clubs and youth groups</navtitle><shortdesc>Regular clubs, groups and sessions for young people to meet, play and take part in activities together, including junior and senior youth clubs and youth councils.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-095" href="../service-type/svc-095.dita">
      <topicmeta><navtitle>Sensory play sessions</navtitle><shortdesc>Sessions where children take part in sensory play and activities, such as sensory rooms, sensory stories, messy play and multi-sensory groups.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-137" href="../service-type/svc-137.dita">
      <topicmeta><navtitle>Parent and toddler groups</navtitle><shortdesc>Regular drop-in sessions where babies, toddlers and pre-schoolers play and socialise together with their parents, grandparents or carers.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-145" href="../service-type/svc-145.dita">
      <topicmeta><navtitle>Childcare and childminding</navtitle><shortdesc>Paid or funded care for children while parents are away, including childminders, day care, creches and funded childcare places.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-167" href="../service-type/svc-167.dita">
      <topicmeta><navtitle>Nursery places and sessions</navtitle><shortdesc>Attending a nursery for care and early education, including day nurseries, maintained nurseries and funded nursery places for under-fives.</shortdesc></topicmeta>
    </subjectdef>
  </subjectdef>
  <subjectdef keys="svc-g01" href="../service-type/svc-g01.dita">
    <topicmeta><navtitle>Arts, crafts and needlework</navtitle><shortdesc>Groups, classes and workshops where people make things by hand, including knitting and sewing, general crafts, drawing and painting.</shortdesc></topicmeta>
    <subjectdef keys="svc-111" href="../service-type/svc-111.dita">
      <topicmeta><navtitle>Knitting, crochet and sewing groups</navtitle><shortdesc>Groups and sessions for knitting, crocheting, sewing and similar needlework, including learning the skill or socialising while doing it.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-133" href="../service-type/svc-133.dita">
      <topicmeta><navtitle>Arts and crafts sessions</navtitle><shortdesc>Sessions, clubs and workshops where people make things by hand, covering general arts and crafts, jewellery making, woodworking and other craft activities.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-138" href="../service-type/svc-138.dita">
      <topicmeta><navtitle>Art groups and classes</navtitle><shortdesc>Taking part in drawing, painting and other art sessions, whether as a class, a relaxed group or an art therapy session.</shortdesc></topicmeta>
    </subjectdef>
  </subjectdef>
  <subjectdef keys="svc-g02" href="../service-type/svc-g02.dita">
    <topicmeta><navtitle>Care, support at home and housing</navtitle><shortdesc>Care and practical support for people who need help day to day, including carers, home care, residential and dementia care, respite, end of life care, befriending, supported housing and bereavement support.</shortdesc></topicmeta>
    <subjectdef keys="svc-008" href="../service-type/svc-008.dita">
      <topicmeta><navtitle>Support for carers</navtitle><shortdesc>Support, information, groups and assessments for people who care for a family member or friend, with a small overlap of phrases about finding or living with a paid carer.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-016" href="../service-type/svc-016.dita">
      <topicmeta><navtitle>Bereavement support</navtitle><shortdesc>Emotional support, groups, information and practical help for people coping after the death of someone close, including after suicide.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-084" href="../service-type/svc-084.dita">
      <topicmeta><navtitle>End of life and palliative care</navtitle><shortdesc>Care and support for people with life-limiting illness as they approach the end of life, including palliative care, symptom control and planning for final days.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-093" href="../service-type/svc-093.dita">
      <topicmeta><navtitle>Respite and short-stay care</navtitle><shortdesc>Short-term or planned stays and care that give a person care while their usual carer takes a break, often alongside residential, nursing or dementia care.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-094" href="../service-type/svc-094.dita">
      <topicmeta><navtitle>Dementia care</navtitle><shortdesc>Residential, nursing and specialist care for people living with dementia, including early onset dementia.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-104" href="../service-type/svc-104.dita">
      <topicmeta><navtitle>Companionship and befriending</navtitle><shortdesc>Friendly company, chat and a reassuring presence for people who are lonely or housebound, including befriending and sitting services.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-116" href="../service-type/svc-116.dita">
      <topicmeta><navtitle>Support at home visits</navtitle><shortdesc>Practical help and support delivered in a person's own home through home visits, home help or a personal assistant.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-121" href="../service-type/svc-121.dita">
      <topicmeta><navtitle>Support to live independently</navtitle><shortdesc>Support, skills sessions and supported rooms or flats that help someone, often disabled, to live as independently as possible in their own home or community.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-129" href="../service-type/svc-129.dita">
      <topicmeta><navtitle>Help with household tasks</navtitle><shortdesc>Practical help with everyday domestic jobs such as cleaning, light housework, errands, cooking and tidying or decluttering the home.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-132" href="../service-type/svc-132.dita">
      <topicmeta><navtitle>Help with bathing and showering</navtitle><shortdesc>Assistance with washing, bathing or showering, or access to shower and bathing facilities.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-134" href="../service-type/svc-134.dita">
      <topicmeta><navtitle>24-hour supported living and live-in care</navtitle><shortdesc>Ongoing care or supported living with staff present round the clock, including live-in care and residential support packages.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-135" href="../service-type/svc-135.dita">
      <topicmeta><navtitle>Supported housing and accommodation</navtitle><shortdesc>Accommodation provided together with support, and help to find or keep a suitable home.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-150" href="../service-type/svc-150.dita">
      <topicmeta><navtitle>Residential and nursing home care</navtitle><shortdesc>Living in a care home, residential or nursing, where care and support are provided on site.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-155" href="../service-type/svc-155.dita">
      <topicmeta><navtitle>Home care services</navtitle><shortdesc>Care and support delivered by carers in a person's own home, described as home care, including personalised and live-in options.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-156" href="../service-type/svc-156.dita">
      <topicmeta><navtitle>Domiciliary care at home</navtitle><shortdesc>Care delivered in people's own homes, described as domiciliary care, covering personal care, medication and daily tasks.</shortdesc></topicmeta>
    </subjectdef>
  </subjectdef>
  <subjectdef keys="svc-g03" href="../service-type/svc-g03.dita">
    <topicmeta><navtitle>Mentoring, coaching and qualifications</navtitle><shortdesc>Guidance and development services such as mentoring, coaching and working towards formal qualifications and awards.</shortdesc></topicmeta>
    <subjectdef keys="svc-009" href="../service-type/svc-009.dita">
      <topicmeta><navtitle>Mentoring</navtitle><shortdesc>One-to-one or peer mentoring where an experienced person guides and supports someone, including volunteer mentor schemes and business mentors.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-089" href="../service-type/svc-089.dita">
      <topicmeta><navtitle>Coaching and money coaching</navtitle><shortdesc>Coaching sessions and short coaching courses, such as career, job, recovery or money coaching, to help someone reach goals.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-165" href="../service-type/svc-165.dita">
      <topicmeta><navtitle>Gaining qualifications and awards</navtitle><shortdesc>Working towards or earning formal qualifications, awards and accredited certificates, such as vocational awards, A levels or Duke of Edinburgh.</shortdesc></topicmeta>
    </subjectdef>
  </subjectdef>
  <subjectdef keys="svc-g04" href="../service-type/svc-g04.dita">
    <topicmeta><navtitle>Community groups and social activities</navtitle><shortdesc>Social, community and group activities where people meet, volunteer, join peer support, worship, read, sing, play music, do drama or enjoy general activities.</shortdesc></topicmeta>
    <subjectdef keys="svc-007" href="../service-type/svc-007.dita">
      <topicmeta><navtitle>Worship and faith gatherings</navtitle><shortdesc>Attending religious services, worship meetings and faith-based groups, mainly Christian, and finding places of worship.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-060" href="../service-type/svc-060.dita">
      <topicmeta><navtitle>Book clubs and reading groups</navtitle><shortdesc>Regular small groups that meet to read and discuss books, plus related writing groups where members share their own work.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-065" href="../service-type/svc-065.dita">
      <topicmeta><navtitle>Support to access the community</navtitle><shortdesc>Help for someone to get out into their local community, find activities and services and take part in community life.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-067" href="../service-type/svc-067.dita">
      <topicmeta><navtitle>Volunteering and giving time</navtitle><shortdesc>Becoming a volunteer, member or fundraiser and contributing time and effort to a charity, club, event or local community.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-068" href="../service-type/svc-068.dita">
      <topicmeta><navtitle>Community activities and projects</navtitle><shortdesc>Joining in general community events, projects, groups and activities run locally for residents.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-076" href="../service-type/svc-076.dita">
      <topicmeta><navtitle>Support group meetings</navtitle><shortdesc>Attending or joining a regular group where people with a shared situation or condition meet to give each other practical and emotional support.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-077" href="../service-type/svc-077.dita">
      <topicmeta><navtitle>Peer support groups</navtitle><shortdesc>Groups, in person or online, where people with shared experiences support each other, including online forums and social media communities.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-092" href="../service-type/svc-092.dita">
      <topicmeta><navtitle>Story and rhyme time sessions</navtitle><shortdesc>Sessions of stories, nursery rhymes, songs and books, mostly for young children and families, such as library story time and Rhyme Time.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-097" href="../service-type/svc-097.dita">
      <topicmeta><navtitle>Holiday clubs and school holiday activities</navtitle><shortdesc>Clubs and groups for children and young people running in school holidays, half terms and sometimes weekends or after school.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-098" href="../service-type/svc-098.dita">
      <topicmeta><navtitle>Making music with instruments</navtitle><shortdesc>Playing, learning or making music with instruments in bands, ensembles, circles and workshops.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-103" href="../service-type/svc-103.dita">
      <topicmeta><navtitle>Meeting people and making friends</navtitle><shortdesc>Gatherings and groups whose purpose is socialising, meeting new people, forming friendships and enjoying company.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-106" href="../service-type/svc-106.dita">
      <topicmeta><navtitle>Singing sessions and sing-alongs</navtitle><shortdesc>Informal group singing, including singing groups, sing-alongs and singing workshops, in person or online.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-125" href="../service-type/svc-125.dita">
      <topicmeta><navtitle>Attending shows, concerts and live entertainment</navtitle><shortdesc>Going to live performances, concerts, shows, screenings, discos and parties as an audience member or guest.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-126" href="../service-type/svc-126.dita">
      <topicmeta><navtitle>Drama and theatre groups</navtitle><shortdesc>Taking part in acting, musical theatre, drama workshops, rehearsals and productions, including backstage roles.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-127" href="../service-type/svc-127.dita">
      <topicmeta><navtitle>Social activities and social time</navtitle><shortdesc>General social activities and programmes offered to encourage social connection, enjoyment and a social life.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-174" href="../service-type/svc-174.dita">
      <topicmeta><navtitle>Monthly meet-ups</navtitle><shortdesc>Attending a regular monthly social meeting or meet-up for members, friendship and mutual support.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-179" href="../service-type/svc-179.dita">
      <topicmeta><navtitle>Social groups and clubs</navtitle><shortdesc>Joining and attending general social groups, clubs and group sessions for company and activities.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-185" href="../service-type/svc-185.dita">
      <topicmeta><navtitle>General activities and activity programmes</navtitle><shortdesc>Taking part in an unspecified range or variety of activities, events or projects, with no single activity named.</shortdesc></topicmeta>
    </subjectdef>
  </subjectdef>
  <subjectdef keys="svc-g05" href="../service-type/svc-g05.dita">
    <topicmeta><navtitle>Mobility equipment and community transport</navtitle><shortdesc>Equipment that helps disabled people with mobility and daily living, and transport services that help people get to appointments and activities.</shortdesc></topicmeta>
    <subjectdef keys="svc-048" href="../service-type/svc-048.dita">
      <topicmeta><navtitle>Adaptive and mobility equipment</navtitle><shortdesc>Getting, trying, hiring or adapting equipment, aids and clothing that help disabled people with mobility, sensory needs and daily living.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-082" href="../service-type/svc-082.dita">
      <topicmeta><navtitle>Community transport and rides</navtitle><shortdesc>Getting transport such as dial-a-ride, shuttle buses, minibuses or volunteer car rides to appointments, social events and other places.</shortdesc></topicmeta>
    </subjectdef>
  </subjectdef>
  <subjectdef keys="svc-g06" href="../service-type/svc-g06.dita">
    <topicmeta><navtitle>Advice, advocacy and practical support</navtitle><shortdesc>Individual help, advice and support including advocacy, benefits and debt advice, signposting, helplines, domestic abuse support and help with appointments.</shortdesc></topicmeta>
    <subjectdef keys="svc-001" href="../service-type/svc-001.dita">
      <topicmeta><navtitle>Advocacy</navtitle><shortdesc>Receiving or providing advocacy, where someone speaks up for a person or helps them have their voice heard in health, social care and other decisions.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-080" href="../service-type/svc-080.dita">
      <topicmeta><navtitle>Emotional and practical support</navtitle><shortdesc>Receiving emotional, psychological or practical support, including combined emotional and practical help.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-085" href="../service-type/svc-085.dita">
      <topicmeta><navtitle>One-to-one support</navtitle><shortdesc>Receiving individual support from a worker or volunteer on a one-to-one basis, often with information, advice or skills help.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-118" href="../service-type/svc-118.dita">
      <topicmeta><navtitle>Domestic abuse and sexual violence support</navtitle><shortdesc>Support, advice, information and safe accommodation for people affected by domestic abuse, sexual violence or other forms of abuse and violence.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-124" href="../service-type/svc-124.dita">
      <topicmeta><navtitle>Signposting and referral to other services</navtitle><shortdesc>Being pointed or referred on to other organisations, services or professionals that can provide the right help.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-143" href="../service-type/svc-143.dita">
      <topicmeta><navtitle>Benefits and grants help</navtitle><shortdesc>Getting information, checks and help to understand, claim and apply for benefits, grants and other financial support.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-162" href="../service-type/svc-162.dita">
      <topicmeta><navtitle>Help arranging and attending appointments</navtitle><shortdesc>Practical help to book, prepare for, get to or be accompanied at appointments, meetings and hearings.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-163" href="../service-type/svc-163.dita">
      <topicmeta><navtitle>Money, budgeting and debt advice</navtitle><shortdesc>Advice and practical support with managing money, budgeting, debt, bills and financial worries.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-181" href="../service-type/svc-181.dita">
      <topicmeta><navtitle>Telephone helpline support</navtitle><shortdesc>Getting information, advice, emotional support or counselling by speaking to someone on a telephone helpline or phone call.</shortdesc></topicmeta>
    </subjectdef>
  </subjectdef>
  <subjectdef keys="svc-g07" href="../service-type/svc-g07.dita">
    <topicmeta><navtitle>Mental health and wellbeing support</navtitle><shortdesc>Support, therapies, courses and programmes for mental health, addiction recovery and general health and wellbeing.</shortdesc></topicmeta>
    <subjectdef keys="svc-024" href="../service-type/svc-024.dita">
      <topicmeta><navtitle>Structured recovery programmes and workshops</navtitle><shortdesc>Time-limited recovery or supportive programmes and workshops, often several weeks long, that help people recover and prevent relapse.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-053" href="../service-type/svc-053.dita">
      <topicmeta><navtitle>Wellbeing sessions and activities</navtitle><shortdesc>Group sessions, workshops and activity programmes aimed generally at improving health and wellbeing.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-054" href="../service-type/svc-054.dita">
      <topicmeta><navtitle>Drug, alcohol and addiction support</navtitle><shortdesc>Support, advice, groups and harm reduction services for people who want to cut down, stop or stay safe around drugs, alcohol, gambling or other addictions.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-066" href="../service-type/svc-066.dita">
      <topicmeta><navtitle>Healthy living and wellbeing support</navtitle><shortdesc>Support to make healthy lifestyle changes and improve overall physical and mental wellbeing, including help with eating and smoking.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-087" href="../service-type/svc-087.dita">
      <topicmeta><navtitle>Mental health support</navtitle><shortdesc>Support, care, information and crisis help for people with mental health difficulties or wanting to look after their mental wellbeing.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-088" href="../service-type/svc-088.dita">
      <topicmeta><navtitle>Mental health courses and training</navtitle><shortdesc>Courses, workshops and training that teach people to understand and manage mental health, stress, anxiety and low mood.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-101" href="../service-type/svc-101.dita">
      <topicmeta><navtitle>Psychological therapies</navtitle><shortdesc>Receiving structured psychological treatments such as CBT, EMDR, psychotherapy and talking therapies.</shortdesc></topicmeta>
    </subjectdef>
  </subjectdef>
  <subjectdef keys="svc-g10" href="../service-type/svc-g10.dita">
    <topicmeta><navtitle>Fitness and exercise classes</navtitle><shortdesc>Classes and sessions for physical activity such as swimming, yoga, Pilates, Tai Chi, martial arts, dance and general fitness.</shortdesc></topicmeta>
    <subjectdef keys="svc-013" href="../service-type/svc-013.dita">
      <topicmeta><navtitle>Swimming sessions and lessons</navtitle><shortdesc>Using a swimming pool, or joining swimming sessions and lessons for children and adults.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-021" href="../service-type/svc-021.dita">
      <topicmeta><navtitle>Pilates classes</navtitle><shortdesc>Pilates classes and sessions, including mat work and reformer Pilates, sometimes combined with yoga.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-022" href="../service-type/svc-022.dita">
      <topicmeta><navtitle>Yoga classes</navtitle><shortdesc>Yoga classes, sessions and workshops of various styles, including gentle, flowing and Vinyasa yoga.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-025" href="../service-type/svc-025.dita">
      <topicmeta><navtitle>Tai Chi and Qigong classes</navtitle><shortdesc>Classes and sessions in Tai Chi, Qigong and related gentle movement practices such as Shibashi and Taiji.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-026" href="../service-type/svc-026.dita">
      <topicmeta><navtitle>Martial arts classes</navtitle><shortdesc>Taking part in martial arts classes or sessions such as karate, Taekwon-Do, aikido or mixed martial arts, for adults, children or families.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-036" href="../service-type/svc-036.dita">
      <topicmeta><navtitle>Fitness and exercise classes</navtitle><shortdesc>Taking part in general fitness, keep-fit or exercise classes and sessions, including gentle exercise, boxercise, group workouts and coached sports sessions.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-037" href="../service-type/svc-037.dita">
      <topicmeta><navtitle>Dance classes</navtitle><shortdesc>Taking part in dance classes, sessions and groups, including ballet and dance-based fitness workouts.</shortdesc></topicmeta>
    </subjectdef>
  </subjectdef>
  <subjectdef keys="svc-g13" href="../service-type/svc-g13.dita">
    <topicmeta><navtitle>Parent and family support</navtitle><shortdesc>Support, classes and information for parents and families, including antenatal and postnatal classes, baby feeding help and meeting other parents.</shortdesc></topicmeta>
    <subjectdef keys="svc-014" href="../service-type/svc-014.dita">
      <topicmeta><navtitle>Meeting other parents</navtitle><shortdesc>Meeting, chatting and connecting with other parents and carers for company and shared experience.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-031" href="../service-type/svc-031.dita">
      <topicmeta><navtitle>Breastfeeding and baby feeding support</navtitle><shortdesc>Workshops, drop-ins, counselling and information helping parents with breastfeeding and feeding and caring for a new baby.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-032" href="../service-type/svc-032.dita">
      <topicmeta><navtitle>Antenatal and postnatal classes</navtitle><shortdesc>Classes, groups and clinics for pregnancy, birth and the early weeks with a new baby, including antenatal courses, bump and baby yoga or fitness, and postnatal groups.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-041" href="../service-type/svc-041.dita">
      <topicmeta><navtitle>Family support and information</navtitle><shortdesc>Getting information, advice and support for whole families or children, young people and parents, including one-to-one family support.</shortdesc></topicmeta>
    </subjectdef>
  </subjectdef>
  <subjectdef keys="svc-g14" href="../service-type/svc-g14.dita">
    <topicmeta><navtitle>Food, meals and social refreshments</navtitle><shortdesc>Services around food and drink, including food parcels, prepared meals, cooking help, cafes, coffee mornings and lunch clubs.</shortdesc></topicmeta>
    <subjectdef keys="svc-052" href="../service-type/svc-052.dita">
      <topicmeta><navtitle>Coffee mornings</navtitle><shortdesc>Attending coffee mornings and informal meet-ups over coffee, usually a regular weekly social event.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-056" href="../service-type/svc-056.dita">
      <topicmeta><navtitle>Drop-in cuppa and chat</navtitle><shortdesc>Dropping in to have tea, coffee or cake and a friendly chat in company.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-057" href="../service-type/svc-057.dita">
      <topicmeta><navtitle>Food parcels and take-home food</navtitle><shortdesc>Receiving free or low-cost food to take home, such as food parcels, boxes or bags, or choosing items from a larder or community food shop.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-061" href="../service-type/svc-061.dita">
      <topicmeta><navtitle>Ready-made meals</navtitle><shortdesc>Receiving prepared meals, whether home-cooked, delivered, takeaway or served, including for special diets.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-062" href="../service-type/svc-062.dita">
      <topicmeta><navtitle>Cooking and meal preparation help</navtitle><shortdesc>Learning to cook or getting help with preparing meals, including cookery classes, cooking clubs and support with meal preparation.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-063" href="../service-type/svc-063.dita">
      <topicmeta><navtitle>Free refreshments and cafe</navtitle><shortdesc>Getting free or low-cost hot drinks, snacks, cake and light food, including using a cafe at a venue.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-071" href="../service-type/svc-071.dita">
      <topicmeta><navtitle>Getting a lunch or set meal on site</navtitle><shortdesc>Being served a lunch or a multi-course meal at a venue, described as the meal itself rather than a club or group.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-072" href="../service-type/svc-072.dita">
      <topicmeta><navtitle>Lunch clubs and meals with others</navtitle><shortdesc>Social lunch clubs, lunch groups and gatherings to share a meal with other people.</shortdesc></topicmeta>
    </subjectdef>
  </subjectdef>
  <subjectdef keys="svc-g24" href="../service-type/svc-g24.dita">
    <topicmeta><navtitle>Gardening and nature activities</navtitle><shortdesc>Outdoor activities involving growing, gardening, allotments, wildlife and conservation.</shortdesc></topicmeta>
    <subjectdef keys="svc-034" href="../service-type/svc-034.dita">
      <topicmeta><navtitle>Wildlife and conservation activities</navtitle><shortdesc>Taking part in wildlife watching, surveys, habitat management and practical conservation work that protects local nature.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-035" href="../service-type/svc-035.dita">
      <topicmeta><navtitle>Gardening and allotment activities</navtitle><shortdesc>Visiting gardens, taking part in community gardening, allotment and growing sessions, and related talks and plant services.</shortdesc></topicmeta>
    </subjectdef>
  </subjectdef>
  <subjectdef keys="svc-g28" href="../service-type/svc-g28.dita">
    <topicmeta><navtitle>Second-hand goods and shopping help</navtitle><shortdesc>Getting pre-loved clothes and household goods, and help with shopping and errands.</shortdesc></topicmeta>
    <subjectdef keys="svc-028" href="../service-type/svc-028.dita">
      <topicmeta><navtitle>Second-hand clothes and household goods</navtitle><shortdesc>Receiving, donating or swapping pre-loved clothing, furniture and household items, including upcycling and swap shops.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-029" href="../service-type/svc-029.dita">
      <topicmeta><navtitle>Shopping help and errands</navtitle><shortdesc>Getting help with the weekly shop, errands or shopping trips, and shopping at community or charity shops.</shortdesc></topicmeta>
    </subjectdef>
  </subjectdef>
  <subjectdef keys="svc-g29" href="../service-type/svc-g29.dita">
    <topicmeta><navtitle>Sports sessions and clubs</navtitle><shortdesc>Playing team and racket sports, bowls and multi-sport sessions, including football, basketball and sports club membership.</shortdesc></topicmeta>
    <subjectdef keys="svc-019" href="../service-type/svc-019.dita">
      <topicmeta><navtitle>Multi-sport and adapted sport sessions</navtitle><shortdesc>Sessions offering a mix of sports, games and active pastimes, including adapted and SEND sport.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-038" href="../service-type/svc-038.dita">
      <topicmeta><navtitle>Joining a sports club or team</navtitle><shortdesc>Becoming a member of a sports club or team and playing in its leagues, competitions or matches.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-039" href="../service-type/svc-039.dita">
      <topicmeta><navtitle>Basketball and volleyball sessions</navtitle><shortdesc>Taking part in basketball and volleyball sessions, from taster and beginner sessions to training and open games.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-044" href="../service-type/svc-044.dita">
      <topicmeta><navtitle>Weekly football sessions</navtitle><shortdesc>Regular weekly or monthly football sessions, including recreational, coaching, walking football and girls-only sessions.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-045" href="../service-type/svc-045.dita">
      <topicmeta><navtitle>Football sessions</navtitle><shortdesc>Taking part in football or soccer sessions, including free, skills-building and community-run sessions.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-046" href="../service-type/svc-046.dita">
      <topicmeta><navtitle>Racket sports and indoor sports</navtitle><shortdesc>Playing tennis, badminton, table tennis, squash and similar racket or hall sports, including club nights, tournaments and sports hall use.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-047" href="../service-type/svc-047.dita">
      <topicmeta><navtitle>Bowls and bowling sessions</navtitle><shortdesc>Playing or trying bowls, including crown green and short mat bowls, through taster sessions, lessons, social play and club teams.</shortdesc></topicmeta>
    </subjectdef>
  </subjectdef>
  <subjectdef keys="svc-g33" href="../service-type/svc-g33.dita">
    <topicmeta><navtitle>Walking, running, cycling and riding</navtitle><shortdesc>Outdoor active groups and events such as walking, running, cycling and horse riding.</shortdesc></topicmeta>
    <subjectdef keys="svc-011" href="../service-type/svc-011.dita">
      <topicmeta><navtitle>Running events and 5k groups</navtitle><shortdesc>Running, jogging and walking events and groups, such as 5k community events, social runs and club training runs, including volunteering at them.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-012" href="../service-type/svc-012.dita">
      <topicmeta><navtitle>Group cycling and adapted cycling</navtitle><shortdesc>Taking part in organised cycle rides, cycling clubs and inclusive or adapted cycling sessions, including volunteering to help at them.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-017" href="../service-type/svc-017.dita">
      <topicmeta><navtitle>Horse riding and equine activities</navtitle><shortdesc>Riding, driving and other activities with horses and ponies, including riding lessons, pony treks and horse-based therapy or development.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-018" href="../service-type/svc-018.dita">
      <topicmeta><navtitle>Walks and walking groups</navtitle><shortdesc>Taking part in led or self-led walks, health walks and regular walking groups, along with closely related outdoor group activity.</shortdesc></topicmeta>
    </subjectdef>
  </subjectdef>
  <subjectdef keys="svc-g34" href="../service-type/svc-g34.dita">
    <topicmeta><navtitle>Health checks and assessments</navtitle><shortdesc>Having health checks, screenings and assessments of a person's needs, abilities or skills.</shortdesc></topicmeta>
    <subjectdef keys="svc-113" href="../service-type/svc-113.dita">
      <topicmeta><navtitle>Health checks and medical testing</navtitle><shortdesc>Having routine health checks, tests and screenings such as blood pressure, eye tests, baby development checks and other diagnostics.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-157" href="../service-type/svc-157.dita">
      <topicmeta><navtitle>Assessments</navtitle><shortdesc>Having or carrying out an assessment of a person's needs, abilities or skills, such as an initial, clinical, falls, skills or driving assessment.</shortdesc></topicmeta>
    </subjectdef>
  </subjectdef>
  <subjectdef keys="svc-g-other" href="../service-type/svc-g-other.dita">
    <topicmeta><navtitle>Categories not yet in a group</navtitle><shortdesc>Categories that sit alone in the clustering hierarchy.</shortdesc></topicmeta>
    <subjectdef keys="svc-000" href="../service-type/svc-000.dita">
      <topicmeta><navtitle>Hiring rooms and halls</navtitle><shortdesc>Hiring a meeting room, hall, function room or other venue space for meetings, events, training or private functions.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-003" href="../service-type/svc-003.dita">
      <topicmeta><navtitle>Stroke information and support</navtitle><shortdesc>Getting information, talks and peer support for people affected by stroke, including groups and courses about life after stroke.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-006" href="../service-type/svc-006.dita">
      <topicmeta><navtitle>Volunteering information and advice</navtitle><shortdesc>Getting information or advice about finding, applying for or managing volunteering, including rights, benefits, overseas options and setting up volunteer schemes.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-030" href="../service-type/svc-030.dita">
      <topicmeta><navtitle>Archery and shooting sports</navtitle><shortdesc>Taking part in archery, target shooting, airsoft and shooting clubs, with related firearms facilities.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-033" href="../service-type/svc-033.dita">
      <topicmeta><navtitle>Free taster and trial sessions</navtitle><shortdesc>Free introductory, taster or trial sessions that let a person try an activity or class before committing.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-051" href="../service-type/svc-051.dita">
      <topicmeta><navtitle>Sexual health and HIV care</navtitle><shortdesc>Testing, treatment, care, advice and education about sexual health, sexually transmitted infections, HIV and blood borne viruses.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-055" href="../service-type/svc-055.dita">
      <topicmeta><navtitle>Medication support</navtitle><shortdesc>Help with taking, managing and prompting medication, plus related information about prescriptions and prescribed treatments.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-112" href="../service-type/svc-112.dita">
      <topicmeta><navtitle>Foot care and personal grooming</navtitle><shortdesc>Receiving foot care such as chiropody, podiatry and nail cutting, along with related grooming services like hairdressing and wigs.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-114" href="../service-type/svc-114.dita">
      <topicmeta><navtitle>Santa visits and Christmas activities</navtitle><shortdesc>Festive events for children and families such as meeting Santa in a grotto, receiving a gift, and Christmas crafts, treats and lights events.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-120" href="../service-type/svc-120.dita">
      <topicmeta><navtitle>Board games, cards and bingo</navtitle><shortdesc>Playing board games, card games, bingo and similar table games with others, including game clubs and cafe sessions.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-130" href="../service-type/svc-130.dita">
      <topicmeta><navtitle>Home cleaning and laundry help</navtitle><shortdesc>Cleaning and light housekeeping services such as domestic cleaning, laundry and carpet or upholstery cleaning.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-136" href="../service-type/svc-136.dita">
      <topicmeta><navtitle>Housing advice and casework</navtitle><shortdesc>Advice, information and casework on housing problems, such as rights, rent arrears, eviction, repairs, landlords and applications.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-149" href="../service-type/svc-149.dita">
      <topicmeta><navtitle>Employment and job-search support</navtitle><shortdesc>One-to-one or specialist help to find, apply for and keep work, including CV writing, interview preparation and supported employment.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-152" href="../service-type/svc-152.dita">
      <topicmeta><navtitle>Library and lending services</navtitle><shortdesc>Borrowing books and other items from a library or lending library, with some related access to resources.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-164" href="../service-type/svc-164.dita">
      <topicmeta><navtitle>Home energy saving advice</navtitle><shortdesc>Advice and help to save energy and cut fuel bills, including tariffs, insulation, grants, energy suppliers and small energy-saving measures.</shortdesc></topicmeta>
    </subjectdef>
  </subjectdef>
</subjectScheme>
