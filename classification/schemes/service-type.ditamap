  <subjectdef keys="svc-g16" href="../service-type/svc-g16.dita">
    <topicmeta><navtitle>Gardening and walking outdoors</navtitle><shortdesc>Outdoor activities such as gardening, nature-based groups and following walking routes.</shortdesc></topicmeta>
