<subjectScheme id="service-type" xml:lang="en-GB">
  <title>ORUK service type (draft from the pilot)</title>
  <subjectdef keys="svc-g00" href="../service-type/svc-g00.dita">
    <topicmeta><navtitle>Sports and swimming sessions</navtitle><shortdesc>Taking part in sport, from swimming and water sports to team games, racket sports and bowls, including sessions, lessons, facility use and competitions.</shortdesc></topicmeta>
    <subjectdef keys="svc-016" href="../service-type/svc-016.dita">
      <topicmeta><navtitle>Canoeing, kayaking and sailing</navtitle><shortdesc>Taking part in, learning, or hiring equipment for paddle and boat-based water sports such as kayaking, canoeing, paddleboarding, sailing and powerboat trips.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-025" href="../service-type/svc-025.dita">
      <topicmeta><navtitle>Basketball sessions</navtitle><shortdesc>Taking part in basketball sessions of any kind, including drop-in, taster, skills development, walking and beginner basketball.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-034" href="../service-type/svc-034.dita">
      <topicmeta><navtitle>Swimming sessions and lessons</navtitle><shortdesc>Organised swimming sessions, lessons, family or social swims and swimming clubs where people swim or learn to swim as an activity.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-035" href="../service-type/svc-035.dita">
      <topicmeta><navtitle>Swimming pool use</navtitle><shortdesc>Using a swimming pool or pools as a facility, often on a self-directed basis, including pool-and-gym access.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-040" href="../service-type/svc-040.dita">
      <topicmeta><navtitle>Bowls and bowling</navtitle><shortdesc>Playing or trying bowls, including crown green, short mat and indoor bowls, in sessions, taster days and social games.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-046" href="../service-type/svc-046.dita">
      <topicmeta><navtitle>General and multi-sport activities</navtitle><shortdesc>Taking part in sport in general or a mix of different sports and games, rather than one named sport.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-051" href="../service-type/svc-051.dita">
      <topicmeta><navtitle>Sports competitions and tournaments</navtitle><shortdesc>Taking part in competitions, tournaments and the squad training or preparation that leads to them.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-054" href="../service-type/svc-054.dita">
      <topicmeta><navtitle>Badminton and racket sports</navtitle><shortdesc>Playing badminton and closely related indoor racket sports such as squash, racketball and pickleball, plus court hire for them.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-073" href="../service-type/svc-073.dita">
      <topicmeta><navtitle>Football sessions</navtitle><shortdesc>Football and soccer sessions, including free, recreational, skills-building and inclusive sessions for playing and learning the game.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-074" href="../service-type/svc-074.dita">
      <topicmeta><navtitle>Weekly and walking football</navtitle><shortdesc>Regular weekly football sessions, open-access sessions and walking football for people wanting a gentler or social game.</shortdesc></topicmeta>
    </subjectdef>
  </subjectdef>
  <subjectdef keys="svc-g01" href="../service-type/svc-g01.dita">
    <topicmeta><navtitle>Clubs, groups and social activities</navtitle><shortdesc>Joining clubs, performing arts, music, reading and social groups, children's and youth sessions, and informal get-togethers for fun and meeting people.</shortdesc></topicmeta>
    <subjectdef keys="svc-088" href="../service-type/svc-088.dita">
      <topicmeta><navtitle>Online and phone chat groups</navtitle><shortdesc>Keeping in touch or joining group conversations remotely by video call, phone, messaging or webchat.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-093" href="../service-type/svc-093.dita">
      <topicmeta><navtitle>Drama, dance and performing arts</navtitle><shortdesc>Taking part in amateur drama, musical theatre, dance and other performing arts sessions, rehearsals and performances, with some disco and DJ activities.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-095" href="../service-type/svc-095.dita">
      <topicmeta><navtitle>Singing groups and choirs</navtitle><shortdesc>Taking part in singing, whether in a choir, community singing group or informal singing session.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-100" href="../service-type/svc-100.dita">
      <topicmeta><navtitle>Attending live shows and concerts</navtitle><shortdesc>Going to watch live music, comedy, shows and other entertainment as an audience member.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-101" href="../service-type/svc-101.dita">
      <topicmeta><navtitle>Music classes and playing together</navtitle><shortdesc>Learning or playing musical instruments and making music with others in classes, workshops, bands and music clubs.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-102" href="../service-type/svc-102.dita">
      <topicmeta><navtitle>Book clubs and reading groups</navtitle><shortdesc>Meeting to read and discuss books together, including shared reading groups and related writing groups.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-110" href="../service-type/svc-110.dita">
      <topicmeta><navtitle>Story and rhyme time sessions</navtitle><shortdesc>Sessions for young children and families with stories, nursery rhymes, songs and shared books.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-112" href="../service-type/svc-112.dita">
      <topicmeta><navtitle>School holiday clubs</navtitle><shortdesc>Clubs and playschemes for children running in school holidays with games, crafts, sports and outdoor activities.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-114" href="../service-type/svc-114.dita">
      <topicmeta><navtitle>After-school clubs</navtitle><shortdesc>Clubs for school-age children held after the school day, including sports, arts, STEM and homework clubs.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-127" href="../service-type/svc-127.dita">
      <topicmeta><navtitle>Fun activities and social sessions</navtitle><shortdesc>General sessions of fun, creative or themed activities and games for socialising, with no single named activity as the focus.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-128" href="../service-type/svc-128.dita">
      <topicmeta><navtitle>Youth clubs and youth groups</navtitle><shortdesc>Regular club or group sessions for children and young people, with games, activities and peer company.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-147" href="../service-type/svc-147.dita">
      <topicmeta><navtitle>Drop-in support sessions</navtitle><shortdesc>Informal sessions that people can attend without booking to get support, advice, information or a welcome, including some Q&amp;A and volunteer sessions.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-177" href="../service-type/svc-177.dita">
      <topicmeta><navtitle>General clubs and activity groups</navtitle><shortdesc>Joining or attending clubs, interest groups and group sessions where the type of activity is generic or varied.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-184" href="../service-type/svc-184.dita">
      <topicmeta><navtitle>Workshops</navtitle><shortdesc>Attending or running workshops, practical demonstrations and short taught sessions on a topic of interest.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-189" href="../service-type/svc-189.dita">
      <topicmeta><navtitle>Regular group meetings</navtitle><shortdesc>Attending regular, usually monthly, meetings or meet-ups of a club, society or social group.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-190" href="../service-type/svc-190.dita">
      <topicmeta><navtitle>Spending time with friends</navtitle><shortdesc>Casual time together with friends and family, hanging out, chatting and catching up without a set activity.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-193" href="../service-type/svc-193.dita">
      <topicmeta><navtitle>Meeting new people and making friends</navtitle><shortdesc>Groups and gatherings whose aim is meeting new people, forming friendships and building confidence or skills alongside.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-211" href="../service-type/svc-211.dita">
      <topicmeta><navtitle>Borrowing books and reading material</navtitle><shortdesc>Borrowing, browsing or reading books, audiobooks, magazines, newspapers and similar items from a library or lending collection.</shortdesc></topicmeta>
    </subjectdef>
  </subjectdef>
  <subjectdef keys="svc-g02" href="../service-type/svc-g02.dita">
    <topicmeta><navtitle>Housing advice and support</navtitle><shortdesc>Advice about housing and hands-on help to find, keep or receive accommodation.</shortdesc></topicmeta>
    <subjectdef keys="svc-215" href="../service-type/svc-215.dita">
      <topicmeta><navtitle>Housing advice and information</navtitle><shortdesc>Advice, guidance and information about housing issues, rights, options and tenancy applications.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-216" href="../service-type/svc-216.dita">
      <topicmeta><navtitle>Supported housing and accommodation help</navtitle><shortdesc>Receiving housing or accommodation itself, or hands-on help to find a home and keep a tenancy, especially for people who are homeless or need support.</shortdesc></topicmeta>
    </subjectdef>
  </subjectdef>
  <subjectdef keys="svc-g03" href="../service-type/svc-g03.dita">
    <topicmeta><navtitle>Free food and household goods</navtitle><shortdesc>Getting free, low-cost or emergency food, food parcels, second-hand goods and help with shopping for essentials.</shortdesc></topicmeta>
    <subjectdef keys="svc-071" href="../service-type/svc-071.dita">
      <topicmeta><navtitle>Free and second-hand household goods</navtitle><shortdesc>Receiving, swapping or donating pre-loved clothing, furniture, baby items and other household essentials.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-072" href="../service-type/svc-072.dita">
      <topicmeta><navtitle>Shopping and buying items</navtitle><shortdesc>Buying goods from a community or on-site shop, or getting help with shopping, plus borrowing equipment.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-078" href="../service-type/svc-078.dita">
      <topicmeta><navtitle>Free and affordable food access</navtitle><shortdesc>Getting free, low-cost or discounted food, groceries and meals, including schemes for people on low incomes.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-098" href="../service-type/svc-098.dita">
      <topicmeta><navtitle>Take-home food parcels</navtitle><shortdesc>Collecting or receiving pre-packed food boxes, bags or parcels to take home.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-099" href="../service-type/svc-099.dita">
      <topicmeta><navtitle>Emergency food and crisis supplies</navtitle><shortdesc>Short-term emergency food, hot meals and essential items provided to people in crisis.</shortdesc></topicmeta>
    </subjectdef>
  </subjectdef>
  <subjectdef keys="svc-g04" href="../service-type/svc-g04.dita">
    <topicmeta><navtitle>Community cafes and shared meals</navtitle><shortdesc>Eating and drinking together at cafes, lunch and breakfast clubs, coffee mornings and drop-ins, plus learning to cook healthy meals.</shortdesc></topicmeta>
    <subjectdef keys="svc-066" href="../service-type/svc-066.dita">
      <topicmeta><navtitle>Cooking classes and healthy eating</navtitle><shortdesc>Learning to cook and prepare healthy meals, in classes, courses and sessions, including help with meal preparation.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-067" href="../service-type/svc-067.dita">
      <topicmeta><navtitle>Community cafe</navtitle><shortdesc>Visiting a community or on-site cafe to eat or drink, including pay-as-you-feel and low-cost cafes.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-069" href="../service-type/svc-069.dita">
      <topicmeta><navtitle>Breakfast clubs</navtitle><shortdesc>Attending a breakfast club or community breakfast, including school breakfast clubs and informal breakfast get-togethers.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-076" href="../service-type/svc-076.dita">
      <topicmeta><navtitle>Lunch clubs and food clubs</navtitle><shortdesc>Attending a regular lunch, dinner or food club where people share a meal or collect low-cost food.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-083" href="../service-type/svc-083.dita">
      <topicmeta><navtitle>Lunches and hot meals on site</navtitle><shortdesc>Eating a lunch or hot meal at a venue, from a light lunch to a three-course meal, often as part of a day out or social occasion.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-094" href="../service-type/svc-094.dita">
      <topicmeta><navtitle>Coffee mornings</navtitle><shortdesc>Attending a coffee morning or coffee meet-up to socialise over tea, coffee and cake.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-103" href="../service-type/svc-103.dita">
      <topicmeta><navtitle>Free food and hot drinks</navtitle><shortdesc>Receiving free or low-cost hot drinks, snacks, cake and light meals at a warm or welcoming venue.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-107" href="../service-type/svc-107.dita">
      <topicmeta><navtitle>Cuppa and a chat drop-in</navtitle><shortdesc>Dropping in for a cup of tea or coffee, cake and informal conversation with others.</shortdesc></topicmeta>
    </subjectdef>
  </subjectdef>
  <subjectdef keys="svc-g06" href="../service-type/svc-g06.dita">
    <topicmeta><navtitle>Therapies and relaxation sessions</navtitle><shortdesc>Receiving or taking part in therapeutic and relaxation services such as counselling, physiotherapy, complementary therapies, yoga and mindfulness.</shortdesc></topicmeta>
    <subjectdef keys="svc-006" href="../service-type/svc-006.dita">
      <topicmeta><navtitle>Mindfulness and meditation</navtitle><shortdesc>Taking part in or learning mindfulness, meditation and related relaxation or self-compassion courses and groups.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-027" href="../service-type/svc-027.dita">
      <topicmeta><navtitle>Yoga classes</navtitle><shortdesc>Taking part in yoga classes and sessions of any style, including gentle yoga and yoga therapy.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-197" href="../service-type/svc-197.dita">
      <topicmeta><navtitle>Physiotherapy and rehabilitation</navtitle><shortdesc>Receiving physiotherapy, occupational therapy and structured rehabilitation to recover or maintain physical function.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-206" href="../service-type/svc-206.dita">
      <topicmeta><navtitle>Counselling and talking therapy</navtitle><shortdesc>Receiving one-to-one counselling, psychotherapy or other talking therapies from a trained professional.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-209" href="../service-type/svc-209.dita">
      <topicmeta><navtitle>Complementary therapies</navtitle><shortdesc>Receiving or learning complementary and holistic treatments such as Reiki, acupuncture, massage, reflexology and crystal healing.</shortdesc></topicmeta>
    </subjectdef>
  </subjectdef>
  <subjectdef keys="svc-g07" href="../service-type/svc-g07.dita">
    <topicmeta><navtitle>Advice, advocacy and one-to-one support</navtitle><shortdesc>Getting advice, advocacy, signposting and individual or phone-based support on money, legal, immigration and other everyday problems.</shortdesc></topicmeta>
    <subjectdef keys="svc-158" href="../service-type/svc-158.dita">
      <topicmeta><navtitle>Signposting to other services</navtitle><shortdesc>Being pointed or referred to other organisations and services that can provide the right help.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-180" href="../service-type/svc-180.dita">
      <topicmeta><navtitle>Legal advice</navtitle><shortdesc>Getting advice, representation or accompaniment on legal matters and rights, including help at court.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-181" href="../service-type/svc-181.dita">
      <topicmeta><navtitle>Advocacy</navtitle><shortdesc>Receiving independent advocacy to be heard, understand rights and take part in decisions about care and support.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-201" href="../service-type/svc-201.dita">
      <topicmeta><navtitle>Helplines and phone support</navtitle><shortdesc>Getting help, advice, counselling or friendly contact by phone, helpline, text or similar remote contact.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-214" href="../service-type/svc-214.dita">
      <topicmeta><navtitle>Free money and benefits advice</navtitle><shortdesc>Getting free, confidential and impartial advice on money, debt, benefits, housing and related problems.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-217" href="../service-type/svc-217.dita">
      <topicmeta><navtitle>One-to-one support</navtitle><shortdesc>Getting individual support from a worker or volunteer on a one-to-one basis, in person, by phone or online.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-219" href="../service-type/svc-219.dita">
      <topicmeta><navtitle>Multi-issue and immigration advice</navtitle><shortdesc>Advice and casework covering several problems at once, such as benefits, housing and welfare, together with asylum, immigration and migrant support.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-220" href="../service-type/svc-220.dita">
      <topicmeta><navtitle>Money, debt and benefits advice</navtitle><shortdesc>Advice and support about money problems, debt, welfare benefits, cost of living and related financial matters.</shortdesc></topicmeta>
    </subjectdef>
  </subjectdef>
  <subjectdef keys="svc-g08" href="../service-type/svc-g08.dita">
    <topicmeta><navtitle>Exercise and dance classes</navtitle><shortdesc>Taking part in fitness, exercise, dance, martial arts and outdoor activity classes and sessions, including seated and gentle options and gym use.</shortdesc></topicmeta>
    <subjectdef keys="svc-000" href="../service-type/svc-000.dita">
      <topicmeta><navtitle>Zumba classes</navtitle><shortdesc>Taking part in Zumba and Zumba Gold dance fitness classes.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-004" href="../service-type/svc-004.dita">
      <topicmeta><navtitle>Pilates classes</navtitle><shortdesc>Taking part in Pilates classes, including mat, chair and reformer Pilates, with some mixed yoga and Pilates classes.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-005" href="../service-type/svc-005.dita">
      <topicmeta><navtitle>Tai Chi and Qigong</navtitle><shortdesc>Taking part in Tai Chi and Qigong classes and sessions, including seated versions.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-007" href="../service-type/svc-007.dita">
      <topicmeta><navtitle>Boxing and kickboxing</navtitle><shortdesc>Taking part in boxing, boxercise-style and kickboxing sessions and classes, including women-only sessions.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-010" href="../service-type/svc-010.dita">
      <topicmeta><navtitle>Martial arts and self-defence</navtitle><shortdesc>Taking part in martial arts classes such as karate and kung fu, and self-defence training.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-041" href="../service-type/svc-041.dita">
      <topicmeta><navtitle>Ballet and tap classes</navtitle><shortdesc>Taking part in ballet classes, including adult beginner to advanced and graded classes, and adult tap dance classes.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-045" href="../service-type/svc-045.dita">
      <topicmeta><navtitle>Chair-based exercise</navtitle><shortdesc>Taking part in exercise classes and groups done sitting on a chair.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-048" href="../service-type/svc-048.dita">
      <topicmeta><navtitle>Running, jogging and walking events</navtitle><shortdesc>Taking part in running, jogging and run-walk groups and timed events, with some other outdoor sports such as horse riding and triathlon.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-049" href="../service-type/svc-049.dita">
      <topicmeta><navtitle>Cycling and bike rides</navtitle><shortdesc>Taking part in cycle rides, cycling groups, adapted cycling and bike maintenance, with some other riding and hobby activities.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-050" href="../service-type/svc-050.dita">
      <topicmeta><navtitle>Low-impact exercise classes</navtitle><shortdesc>Taking part in gentle exercise, dance, circuit and aerobic classes designed to be low impact.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-053" href="../service-type/svc-053.dita">
      <topicmeta><navtitle>Social dance sessions</navtitle><shortdesc>Taking part in dance sessions for enjoyment, including line dancing, sequence dancing, circle dancing and general dance and movement.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-065" href="../service-type/svc-065.dita">
      <topicmeta><navtitle>Seated exercise classes</navtitle><shortdesc>Taking part in exercise classes and groups done from a seated position, including gentle movement and strengthening.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-077" href="../service-type/svc-077.dita">
      <topicmeta><navtitle>Strength and balance classes</navtitle><shortdesc>Taking part in exercise classes aimed at building strength, balance, mobility and flexibility, often for older people.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-085" href="../service-type/svc-085.dita">
      <topicmeta><navtitle>Gym use and exercise</navtitle><shortdesc>Using a gym, fitness studio or weights equipment, and exercising or working out in gym-style fitness settings.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-086" href="../service-type/svc-086.dita">
      <topicmeta><navtitle>General fitness and exercise classes</navtitle><shortdesc>Taking part in general group fitness or exercise classes, such as circuits, functional fitness and keep-fit.</shortdesc></topicmeta>
    </subjectdef>
  </subjectdef>
  <subjectdef keys="svc-g09" href="../service-type/svc-g09.dita">
    <topicmeta><navtitle>Home care and carer support</navtitle><shortdesc>Support for carers and practical, personal and social care or visits for people who need help to live independently at home.</shortdesc></topicmeta>
    <subjectdef keys="svc-091" href="../service-type/svc-091.dita">
      <topicmeta><navtitle>Carers support and information</navtitle><shortdesc>Information, advice, assessments and support for people who care for family or friends, along with some information on advocacy and legal safeguards.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-104" href="../service-type/svc-104.dita">
      <topicmeta><navtitle>Respite care for carers</navtitle><shortdesc>Services that give carers a break from caring, through respite care, breaks or day centres for the person cared for.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-118" href="../service-type/svc-118.dita">
      <topicmeta><navtitle>Companionship and befriending visits</navtitle><shortdesc>Regular company, social visits or sitting services for someone who is isolated or needs a reassuring presence, usually at home.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-133" href="../service-type/svc-133.dita">
      <topicmeta><navtitle>Personal care and washing help</navtitle><shortdesc>Help with personal hygiene and grooming such as bathing, showering, dressing, foot care, or use of shower facilities.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-141" href="../service-type/svc-141.dita">
      <topicmeta><navtitle>Help with household tasks</navtitle><shortdesc>Practical help around the home such as light cleaning, chores, errands, simple cooking and general handyman jobs.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-142" href="../service-type/svc-142.dita">
      <topicmeta><navtitle>Support to live independently</navtitle><shortdesc>Support, skills teaching and information that help a person keep or build independence, usually in their own home.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-161" href="../service-type/svc-161.dita">
      <topicmeta><navtitle>Home visiting and visitor support</navtitle><shortdesc>Visits to people at home or in care settings, and visiting-based practical or emotional support, including home help visits.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-162" href="../service-type/svc-162.dita">
      <topicmeta><navtitle>Home care at home</navtitle><shortdesc>Receiving personal and domiciliary care in your own home, including live-in care and home health services.</shortdesc></topicmeta>
    </subjectdef>
  </subjectdef>
  <subjectdef keys="svc-g10" href="../service-type/svc-g10.dita">
    <topicmeta><navtitle>Free trials and tasters</navtitle><shortdesc>Free or low-cost introductory consultations, trial passes and taster sessions to try a service or activity before committing.</shortdesc></topicmeta>
    <subjectdef keys="svc-019" href="../service-type/svc-019.dita">
      <topicmeta><navtitle>Free initial consultation or assessment</navtitle><shortdesc>A free first meeting, consultation, quote or assessment offered before committing to a service.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-023" href="../service-type/svc-023.dita">
      <topicmeta><navtitle>Free trial sessions and passes</navtitle><shortdesc>A free or low-cost try-out of a session, class, pass or service before joining or paying regularly.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-024" href="../service-type/svc-024.dita">
      <topicmeta><navtitle>Taster sessions</navtitle><shortdesc>Short introductory taster sessions, often free, that let people sample an activity or group.</shortdesc></topicmeta>
    </subjectdef>
  </subjectdef>
  <subjectdef keys="svc-g11" href="../service-type/svc-g11.dita">
    <topicmeta><navtitle>Arts, crafts and making groups</navtitle><shortdesc>Taking part in hands-on creative groups such as arts and crafts, knitting, sewing and Lego or model building.</shortdesc></topicmeta>
    <subjectdef keys="svc-070" href="../service-type/svc-070.dita">
      <topicmeta><navtitle>Lego and model building groups</navtitle><shortdesc>Hands-on building and making activities, mainly Lego clubs and Lego therapy, plus model and toy making.</shortdesc></topicmeta>
    </subjectdef>
    <subjectdef keys="svc-081" href="../service-type/svc-081.dita">
